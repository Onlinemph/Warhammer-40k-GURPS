{
 "about": "Which Dawn of War II sounds the 3D replay plays for what. Each key is an event in the replay (see tools/sim/page/32-view3d-sound.js); a key ending in a race (ork, nid, eld, ig) is used for that race's figures. 'dir' is a folder in the game's sound archives, 'match' a regular expression on the file name, 'max' how many to take (default 4), 'seconds' where to cut a long one (default 2.5).",
 "sounds": {
  "fire.bolt": {"dir": "wav/sfx/weapons/space_marine/bolter", "match": "^bolter_single", "max": 6},
  "fire.las": {"dir": "wav/sfx/weapons/ig/lazgun", "match": "fire"},
  "fire.slug": {"dir": "wav/sfx/weapons/chaos/autogun", "match": "fire", "max": 5, "seconds": 0.8},
  "fire.slug.ork": {"dir": "wav/sfx/weapons/ork/or_x_weap_shoota", "match": "^shoota_new2", "max": 6, "seconds": 0.6},
  "fire.plasma": {"dir": "wav/sfx/weapons/space_marine/plasma_small", "match": "plasma_shot"},
  "fire.melta": {"dir": "wav/sfx/weapons/space_marine/melta", "match": "^melta_atk"},
  "fire.lascannon": {"dir": "wav/sfx/weapons/space_marine/lascannon", "match": "^lascannon_(v5|comp)", "seconds": 2.0},
  "fire.flame": {"dir": "wav/sfx/weapons/shared/range_flamers", "match": "flamethrower|attack", "seconds": 1.6},
  "fire.warpflame": {"dir": "wav/sfx/weapons/shared/range_flamers", "match": "flamethrower|attack", "seconds": 1.6},
  "fire.shell": {"dir": "wav/sfx/weapons/shared/range_fire_launcher_attack", "match": "launcher_fire"},
  "fire.lob": {"dir": "wav/sfx/weapons/shared/range_fire_launcher_attack", "match": "launcher_fire"},
  "fire.shell.ork": {"dir": "wav/sfx/weapons/shared/range_fire_launcher_attack", "match": "tankbusta_fire", "seconds": 1.8},
  "fire.shuriken": {"dir": "wav/sfx/weapons/eldar/shuriken_catapult", "match": "^shuriken_new2", "max": 5, "seconds": 0.7},
  "fire.splinter": {"dir": "wav/sfx/weapons/eldar/shuriken_pistol", "match": "."},
  "fire.pulse": {"dir": "wav/sfx/weapons/eldar/pulse_cannon", "match": "."},
  "fire.gauss": {"dir": "wav/sfx/weapons/eldar/brightlance", "match": "fire", "seconds": 1.4},
  "fire.dark": {"dir": "wav/sfx/weapons/eldar/brightlance", "match": "laser|fire_0[12]", "seconds": 1.4},
  "fire.bio": {"dir": "wav/sfx/weapons/tyranid/tyranid_devourer", "match": "^devourer_new2", "max": 5},
  "hit.flesh": {"dir": "wav/sfx/bullet_hits/flesh", "match": ".", "max": 6},
  "hit.armour": {"dir": "wav/sfx/bullet_hits/metal", "match": ".", "max": 6},
  "hit.glance": {"dir": "wav/sfx/bullet_hits/ricochet", "match": ".", "max": 6},
  "hit.shield": {"dir": "wav/sfx/bullet_hits/shield", "match": "^sm_", "max": 5},
  "blast": {"dir": "wav/sfx/destruction/explosions/attack", "match": ".", "max": 6, "seconds": 3},
  "swing": {"dir": "wav/sfx/weapons/shared/melee_whooshes", "match": "whoosh_med", "max": 6},
  "swing.chain": {"dir": "wav/sfx/weapons/space_marine/chainsword_sm", "match": "swing", "max": 5},
  "swing.fist": {"dir": "wav/sfx/weapons/shared/melee_whooshes", "match": "whoosh_lrg", "max": 5, "seconds": 1.0},
  "swing.hammer": {"dir": "wav/sfx/weapons/shared/melee_whooshes", "match": "whoosh_lrg", "max": 5, "seconds": 1.0},
  "swing.claw": {"dir": "wav/sfx/weapons/shared/melee_whooshes", "match": "whoosh_sml", "max": 6},
  "melee": {"dir": "wav/sfx/weapons/shared/melee_blade_slash", "match": ".", "max": 6, "seconds": 1.2},
  "melee.chain": {"dir": "wav/sfx/weapons/space_marine/chainsword_sm", "match": "hit"},
  "melee.fist": {"dir": "wav/sfx/weapons/shared/melee_fist_punch", "match": ".", "max": 6},
  "melee.hammer": {"dir": "wav/sfx/weapons/shared/melee_hammer_hit", "match": ".", "seconds": 1.5},
  "melee.axe": {"dir": "wav/sfx/weapons/shared/melee_axe_hit", "match": ".", "max": 5, "seconds": 1.5},
  "melee.claw": {"dir": "wav/sfx/weapons/shared/melee_flesh_gish", "match": "gish", "max": 6},
  "fall": {"dir": "wav/sfx/foley/bodyfalls/base", "match": ".", "max": 6},
  "fall.armour": {"dir": "wav/sfx/foley/bodyfalls/armour", "match": ".", "max": 5}
 }
}
