				{
					"id": "W4uMui6mueP4lFZGJ",
					"sv": 1,
					"damage": {
						"type": "burn",
						"base": "2d"
					},
					"range": "5",
					"shots": "4(5)",
					"bulk": "-3",
					"strength": "9†",
					"usage": "Follow-up (per turn while ablaze)",
					"usage_notes": "A target who fails an HT roll on being hit catches fire and takes this every turn until extinguished (B433); DR does not stop it. Unlike promethium, warpflame needs no fuel or air: it catches on anyone, a hermetically sealed suit included, and its burning reaches the wearer through any armour.",
