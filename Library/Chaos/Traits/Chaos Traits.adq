							],
							"base_points": 10
						},
						{
							"id": "tJe8j5mmY28jcXz8W",
							"name": "Doesn't Sleep",
							"reference": "B50",
							"tags": [
								"Advantage",
								"Physical"
							],
							"base_points": 20
						}
					]
				},
				{
					"id": "TSXJQed8_MVzcJ2eR",
					"name": "Rubric Mind",
					"local_notes": "Design: 15 - 40 = -25 points.",
					"tags": [
						"Advantage",
						"Disadvantage",
						"Mental"
					],
					"container_type": "meta_trait",
					"children": [
						{
							"id": "t9VicpmGQxagEjxak",
							"name": "Unfazeable",
							"reference": "B95",
							"tags": [
								"Advantage",
								"Mental"
							],
							"base_points": 15
						},
						{
							"id": "trlYb9WSofquGQo6f",
							"name": "Slave Mentality (Its Sorcerer)",
							"reference": "B154",
							"local_notes": "No self-control roll. Obeys its Aspiring Sorcerer and cannot act against the Sorcerer's orders. The Sorcerer is whoever speaks the Rubric's will at the time.",
							"tags": [
								"Disadvantage",
								"Mental"
							],
							"base_points": -40
						}
					]
				},
				{
					"id": "Tp3trWwb2lFs1KsxH",
					"name": "All Is Dust",
					"local_notes": "Lore: \"All is dust.\" The Rubric's sorcery binds each warrior's soul into its armour, and the sorcery wards it: a Rubric Marine shrugs off fire that would drop a living Astartes and keeps walking until the suit itself is torn apart. The tabletop gives them an invulnerable save and makes small arms less effective against them.\n\nDesign: Warding field at 0.5 point per SP, as the Mark of Tzeentch's (20 SP, 10 points), standing for the tabletop's invulnerable save; Hard to Subdue 5 (B59, 2/level) 10 for \"All is Dust\". 10 + 10 = 20 points.",
					"tags": [
						"Advantage",
						"Physical",
						"Tzeentch"
					],
					"container_type": "meta_trait",
					"children": [
						{
							"id": "tRnjiI0azdTS-xV1W",
							"name": "Warding Field (Rubric)",
							"local_notes": "Shield Points 20, as the project's personal force-field rules (framework.md, \"Personal force fields\"): damage comes off SP first and armour divisors do not apply to SP; excess carries on to the armour at the attack's full divisor. Covers all attacks. Recharge: after 3 seconds with no damage it regains 10 SP per second; a field knocked to 0 waits double that delay.",
							"tags": [
								"Advantage",
								"Physical"
							],
							"base_points": 10
						},
						{
							"id": "tJwYZqQnXmrfWxp7r",
							"name": "Hard to Subdue",
							"reference": "B59",
							"local_notes": "+5 to HT rolls to stay conscious. There is no body in the suit to faint: a Rubric goes down when the armour is broken open, not when it is hurt.",
							"tags": [
								"Advantage",
								"Physical"
							],
							"points_per_level": 2,
							"can_level": true,
							"levels": 5,
							"base_points": 0
						}
					]
				}
			]
		},
		{
			"id": "TxqLvRp3aCO4aeajW",
			"name": "Daemonic Possession (Possessed)",
			"local_notes": "Apply to an Astartes with Personal Advancement (the Legionary line). No guns: a Possessed fights with its warp-grown limbs. The framework's ST 40, DX 16, IQ 8 and HT 16 assume the Battle-Brother's Personal Advancement.\n\nLore: A Possessed is a Chaos Space Marine into whom a daemon has been drawn. Codex: Chaos Space Marines background shows the body twisting and splitting, new limbs growing, the mind pushed aside by something hungrier. The result is a warrior far stronger and tougher than before, capable of taking bolts that would down a Marine, and fit only to be sent against the enemy and not otherwise directed.\n\nDesign: 50 (Attribute Modifiers) + 75 (DR 15, 5/level) + 10 (Fearlessness 5) + 25 (Extra Attack 1) - 10 (Bad Temper, B124) + 38 (Possessed Claws and Tentacles) = 188 points. Unfazeable is left out as too much: the Possessed is not mindless. Fearlessness 5 (B55) per the framework.",
			"tags": [
				"Advantage",
				"Disadvantage",
				"Physical",
				"Mental",
				"Chaos",
				"Possessed"
			],
			"container_type": "meta_trait",
			"children": [
				{
					"id": "tzkddvjajYbE5SIwt",
					"name": "Attribute Modifiers (Possessed)",
					"local_notes": "Design: Increased ST +10 (B14, 10/level, 100), SM stays 0, for ST 40 on top of the Astartes package's 30; HT +1 (B15, 10); IQ -3 (B16, 20/level, -60). 100 + 10 - 60 = 50. HP follow ST (40 + the package's 4 = 44).",
					"tags": [
						"Physical",
						"Mental"
					],
					"base_points": 50,
					"features": [
						{
							"type": "attribute_bonus",
							"attribute": "st",
							"amount": 10
						},
						{
							"type": "attribute_bonus",
							"attribute": "ht",
							"amount": 1
						},
						{
							"type": "attribute_bonus",
							"attribute": "iq",
							"amount": -3
						}
					]
				},
				{
					"id": "tjcPnr9RpHLKqev27",
					"name": "Damage Resistance (Warp-Flesh)",
					"reference": "B46",
					"local_notes": "DR 15, all locations. Stacks with worn armour.",
					"tags": [
						"Advantage",
						"Physical"
					],
					"points_per_level": 5,
					"can_level": true,
					"levels": 15,
					"base_points": 0,
					"features": [
						{
							"type": "dr_bonus",
							"locations": [
								"all"
							],
							"amount": 15
						}
					]
				},
				{
					"id": "tyBw9dGNPhSVXcAXg",
					"name": "Fearlessness",
					"reference": "B55",
					"local_notes": "+5 to Fright Checks.",
					"tags": [
						"Advantage",
						"Mental"
					],
					"points_per_level": 2,
					"can_level": true,
					"levels": 5,
					"base_points": 0
				},
				{
					"id": "t_QbhSj_xrmXy01NU",
					"name": "Extra Attack (Possessed)",
					"reference": "B53",
					"local_notes": "One extra attack per turn: the claws and tentacles strike twice.",
					"tags": [
						"Advantage",
						"Physical"
					],
					"points_per_level": 25,
					"can_level": true,
					"levels": 1,
					"base_points": 0
				},
				{
					"id": "tZ-aFkYLjEox6MX8N",
					"name": "Bad Temper",
					"reference": "B124",
					"local_notes": "Self-control 12. Snarls, lashes out and refuses to back down.",
					"tags": [
						"Disadvantage",
						"Mental"
					],
					"base_points": -10,
					"cr": 12
				},
				{
					"id": "t9U0GZhUG1Z_HCEDM",
					"name": "Possessed Claws and Tentacles",
					"reference": "B88",
					"local_notes": "sw is the bearer's own swing at ST 40. Uses the Possessed Extra Attack for its second strike.\n\nDesign: Cutting Striker (B88, 7 points) with Armor Divisor (3) (+100%) = 14 for the sw+0(3) baseline, plus Innate Attack (Cut) at 2 dice (7/die = 14) with Armor Divisor (3) and Melee Attack, Reach C (-30%): net +70%, 14 x 1.7 = 23.8, rounded to 24. 14 + 24 = 38, the same build as the Genestealer's Rending Claws. Raised from (2) by user direction: daemonic claws tear ceramite, and at (2) most blows bounced off a Mark VII breastplate (170 of 346 hits in one test), so five Possessed won 7 fights in 40 against five Marines; at (3) they win 55 in 60.",
					"tags": [
						"Advantage",
						"Physical"
					],
					"base_points": 38,
					"weapons": [
						{
							"id": "w5VBQG4YqkXz0l4IX",
							"sv": 1,
							"damage": {
								"type": "cut",
								"st": "sw",
								"base": "2d",
								"armor_divisor": 3
							},
							"reach": "C,1",
							"parry": "0",
							"usage": "Standard",
							"usage_notes": "Natural weapons. Armour does not stop the claws bursting from it.",
							"defaults": [
								{
									"type": "dx",
									"modifier": 0
								},
								{
									"type": "skill",
									"name": {
										"compare": "is",
										"qualifier": "Brawling"
									}
								}
							]
						}
					]
				}
			]
		},
		{
			"id": "TEmGeVMc9uEOXXgn8",
			"name": "Cultist's Devotion",
			"local_notes": "Lore: Chaos cults draw ordinary men and women into the service of the Ruinous Powers. Black Library's Inquisition fiction and Codex background treat the typical cultist as a fanatic indifferent to anyone outside the cult, and the same cultist as the first to die for a Dark God.\n\nDesign: Fanaticism (B136) -15 and Callous (B125) -5, self-control 12 = -20 points. A cultist who follows a single god's Mark also takes that Mark's own disadvantages; Undivided cultists take this in place of Mark of Chaos Undivided.",
			"tags": [
				"Disadvantage",
				"Mental",
				"Chaos",
				"Chaos Cultist"
			],
			"container_type": "meta_trait",
			"children": [
				{
					"id": "tJlNmQ_g24IVnL_lS",
					"name": "Fanaticism (Chaos)",
					"reference": "B136",
					"local_notes": "Devoted to the Ruinous Powers; takes risks for the cult and cannot be reasoned out of it.",
					"tags": [
						"Disadvantage",
						"Mental"
					],
					"base_points": -15
				},
				{
					"id": "tEicVWHW0ChPljAni",
					"name": "Callous",
					"reference": "B125",
					"local_notes": "Indifferent to the suffering of anyone outside the cult.",
					"tags": [
						"Disadvantage",
						"Mental"
					],
					"base_points": -5
				}
			]
		}
	]
}
