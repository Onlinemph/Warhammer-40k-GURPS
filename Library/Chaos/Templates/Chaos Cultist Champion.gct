{
	"version": 5,
	"id": "B_IMRc4O6bQ7i-QFv",
	"notes": "The hardened fanatic who leads a cultist mob: a gang boss, a preacher's enforcer, the one who survived the last purge. Built from the Chaos Cultist (IQ 9 and Cultist's Devotion carry over) with ST 11 (+10), DX 11 (+20), IQ 9 (-20), HT 11 (+10) = 20; Fit 5, Single-Minded 5, Fearlessness 2 4, High Pain Threshold 10 = 24; Cultist's Devotion -20; skills 72. About 96 points, above the plain cultist and below the trained-soldier tier. Leadership 11, Intimidation 12 and a chainsword or crude axe at 12 are what set him apart; wargear is in the wargear files. Add a single god's Mark (Chaos Traits) for a champion of one power.",
	"traits": [
		{
			"id": "tNsVeihhyHitcJOp9",
			"name": "ST",
			"local_notes": "Lore: A cult's strongest bully, fed first and fighting hardest.\n\nDesign: ST 11, +1 over baseline, 10/level (B14).",
			"tags": [
				"Attribute"
			],
			"base_points": 10,
			"features": [
				{
					"type": "attribute_bonus",
					"attribute": "st",
					"amount": 1
				}
			]
		},
		{
			"id": "toCA-viUy36E-6SWq",
			"name": "DX",
			"local_notes": "Lore: A veteran of the cult's brawls and skirmishes.\n\nDesign: DX 11, +1 over baseline, 20/level (B15).",
			"tags": [
				"Attribute"
			],
			"base_points": 20,
			"features": [
				{
					"type": "attribute_bonus",
					"attribute": "dx",
					"amount": 1
				}
			]
		},
		{
			"id": "tXvGdqcIf0ilriyjr",
			"name": "IQ",
			"local_notes": "Lore: Cultists are taken from the desperate and the credulous, and the cult does the thinking.\n\nDesign: IQ 9, Decreased IQ -1 (B16, 20/level) = -20 points.",
			"tags": [
				"Attribute"
			],
			"base_points": -20,
			"features": [
				{
					"type": "attribute_bonus",
					"attribute": "iq",
					"amount": -1
				}
			]
		},
		{
			"id": "trZ4TDjcMUsNOMXJQ",
			"name": "HT",
			"local_notes": "Lore: Survivor of a dozen purges and brawls.\n\nDesign: HT 11, +1 over baseline, 10/level (B14).",
			"tags": [
				"Attribute"
			],
			"base_points": 10,
			"features": [
				{
					"type": "attribute_bonus",
					"attribute": "ht",
					"amount": 1
				}
			]
		},
		{
			"id": "tAJPKumXwXQYQAhsw",
			"name": "Fit",
			"reference": "B55",
			"local_notes": "Lore: Years of hard labour and cult-cellar brawling keep a cultist wiry.\n\nDesign: Basic Set Fit (B55), 5 points.",
			"tags": [
				"Advantage",
				"Physical"
			],
			"base_points": 5
		},
		{
			"id": "tm2FRL0N58iOrfygR",
			"name": "Single-Minded",
			"reference": "B85",
			"local_notes": "Lore: A fanatic's one-track zeal; the Black Library cultist fights through terror and pain towards the altar.\n\nDesign: Single-Minded (B85), 5 points.",
			"tags": [
				"Advantage",
				"Mental",
				"Chaos"
			],
			"base_points": 5
		},
		{
			"id": "t4wUDCnvKBjBpTJYL",
			"name": "Fearlessness",
			"reference": "B55",
			"local_notes": "Lore: Drugs and doctrine have burned out most of a cultist's fear.\n\nDesign: Fearlessness 2 (B55, 2/level), 4 points.",
			"tags": [
				"Advantage",
				"Mental",
				"Chaos"
			],
			"points_per_level": 2,
			"can_level": true,
			"levels": 2
		},
		{
			"id": "tDHrvXDwh8XweGIZe",
			"name": "High Pain Threshold",
			"reference": "B59",
			"local_notes": "Lore: Cult fanatics are shown in Black Library's Inquisition fiction enduring wounds and drugs that would put a sane man down, driven by faith and stimulants.\n\nDesign: High Pain Threshold (B59), 10 points.",
			"tags": [
				"Advantage",
				"Physical",
				"Chaos"
			],
			"base_points": 10
		},
		{
			"id": "TrjZVEjDM7WUbdEmY",
			"name": "Cultist's Devotion",
			"local_notes": "Lore: Chaos cults draw ordinary men and women into the service of the Ruinous Powers. Black Library's Inquisition fiction and Codex background treat the typical cultist as a fanatic indifferent to anyone outside the cult, and the same cultist as the first to die for a Dark God.\n\nDesign: Fanaticism (B136) -15 and Callous (B125) -5, self-control 12 = -20 points. A cultist who follows a single god's Mark also takes that Mark's own disadvantages; Undivided cultists take this in place of Mark of Chaos Undivided.",
			"tags": [
				"Disadvantage",
				"Mental",
				"Chaos",
				"Chaos Cultist"
			],
			"container_type": "meta_trait",
			"children": [
				{
					"id": "tclZzOuNdPiR7E3FB",
					"name": "Fanaticism (Chaos)",
					"reference": "B136",
					"local_notes": "Devoted to the Ruinous Powers; takes risks for the cult and cannot be reasoned out of it.",
					"tags": [
						"Disadvantage",
						"Mental"
					],
					"base_points": -15
				},
				{
					"id": "tFkjVO8TB7LvcolIH",
					"name": "Callous",
					"reference": "B125",
					"local_notes": "Indifferent to the suffering of anyone outside the cult.",
					"tags": [
						"Disadvantage",
						"Mental"
					],
					"base_points": -5
				}
			]
		}
	],
