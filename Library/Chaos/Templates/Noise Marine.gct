					"base_points": 0
				},
				{
					"id": "t2U2L1rUvusbZAvrd",
					"name": "Acute Taste and Smell",
					"reference": "B35",
					"local_notes": "+2 to Taste/Smell rolls.",
					"tags": [
						"Advantage",
						"Physical"
					],
					"points_per_level": 2,
					"can_level": true,
					"levels": 2,
					"base_points": 0
				},
				{
					"id": "tqKXpL19mmVKMpGIR",
					"name": "Compulsive Behavior (Excess)",
					"reference": "B128",
					"local_notes": "Self-control 12. Cannot refuse a new sensation, indulgence or extreme.",
					"tags": [
						"Disadvantage",
						"Mental"
					],
					"base_points": -10,
					"cr": 12
				},
				{
					"id": "tqXCjRILrWmuZgh26",
					"name": "Sadism",
					"reference": "B152",
					"local_notes": "Self-control 12. Takes pleasure in causing pain, and finds reasons to.",
					"tags": [
						"Disadvantage",
						"Mental"
					],
					"base_points": -15,
