						"base": "8dx8",
						"armor_divisor": 5
					},
					"accuracy": "4",
					"range": "200/800",
					"rate_of_fire": "1x2",
					"shots": "6(10)",
					"bulk": "-8",
					"recoil": "2",
					"strength": "28M",
					"usage": "Standard discharge (per barrel)",
