			"id": "sbcXR6vlzXJPCqC24",
			"name": "Brawling",
			"local_notes": "Lore: A Ravener erupts from the ground already lashing out with its scything talons.\n\nDesign: DX+2 (16) for 4 points, Easy.",
			"tags": [
				"Xenos",
				"Tyranids"
			],
			"difficulty": "dx/e",
			"points": 4
