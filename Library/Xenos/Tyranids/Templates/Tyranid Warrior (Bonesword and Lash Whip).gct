							"id": "mluZfTpeCmsslNrFW",
							"name": "Advantage Delivered (grants Synapse Discipline, 10 pts)",
							"cost_adj": "10%"
						},
						{
							"id": "mdC35Z8PWehYN5EC_",
							"name": "Area Effect, 16 yards",
							"cost_adj": "+200%"
						},
						{
							"id": "mjVV7H6mC79OFDGBz",
							"name": "Always On",
							"cost_adj": "-40%"
