				}
			]
		}
	],
	"skills": [
		{
			"id": "sO_RkRhm9VviRk4Oa",
			"name": "Brawling",
			"local_notes": "Lore: A Carnifex's monstrous crushing claws can pulp a light vehicle or a squad's cover in a single blow.\n\nDesign: DX+4 (14) for 12 points, Easy. Raised from 12 after the combat simulator showed a Carnifex almost never landing a blow on a retreating Marine (Dodge 15); a beast bred for nothing but close assault needs a trained fighter's skill.",
			"tags": [
				"Xenos",
				"Tyranids"
			],
			"difficulty": "dx/e",
			"points": 12
		},
		{
			"id": "s1is0Yn4k_gz2aQuP",
			"name": "Innate Attack",
			"local_notes": "Lore: A Carnifex's venom cannon is aimed with as little finesse as everything else about it, but at its size that scarcely matters.\n\nDesign: Innate Attack (Projectile) (DX/E, B201) at DX+2 (12) for 4 points, Easy.",
			"tags": [
				"Xenos",
				"Tyranids"
			],
			"specialization": "Projectile",
			"difficulty": "dx/e",
			"points": 4
