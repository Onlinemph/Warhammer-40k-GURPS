						"type": "cr ex",
						"base": "6dx4",
						"armor_divisor": 3
					},
					"accuracy": "4",
					"range": "250/750",
					"rate_of_fire": "1",
					"shots": "3(90)",
					"usage": "Standard",
					"usage_notes": "ST-independent; grown only on Carnifex-scale bioforms with a torso large enough to house the gland. Shots regrow over the listed time.",
					"defaults": [
						{
							"type": "skill",
