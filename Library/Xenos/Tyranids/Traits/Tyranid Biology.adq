					"cost_adj": "-20%"
				},
				{
					"id": "m1oGHCsrdJzcY053M",
					"name": "Accessibility (only affects psykers and other warp-sensitive minds)",
					"cost_adj": "-20%"
				}
			],
			"base_points": 10
		},
