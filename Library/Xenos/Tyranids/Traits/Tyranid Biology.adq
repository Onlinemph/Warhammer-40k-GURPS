						{
							"id": "mb4iTlJ9yVSntLHXj",
							"name": "Area Effect, 16 yards",
							"cost_adj": "+200%"
						},
						{
							"id": "mcjLtragEH8Yf7W1D",
							"name": "Always On",
							"cost_adj": "-40%"
						},
						{
							"id": "mfL3QNYFsKaemlYs-",
							"name": "Emanation",
							"cost_adj": "-20%"
						}
					],
					"base_points": 10
				},
				{
					"id": "t03D2JBF_l73a-e-S",
					"name": "Shadow in the Warp (Zoanthrope)",
					"reference": "B35",
					"local_notes": "As the Tyranid Warrior's Shadow in the Warp trait, above: 16-yard radius, -3 to psychic rolls, forced Fright Check on first exposure.\n\nLore: A Zoanthrope is a dedicated psychic amplifier for the Hive Mind, carrying as heavy a share of its psychic mass as a Warrior despite its small, frail body.\n\nDesign: Identical build and math to the Tyranid Warrior's Shadow in the Warp trait, above (25 points).",
					"tags": [
						"Advantage",
						"Mental",
						"Xenos",
						"Tyranids"
					],
					"modifiers": [
						{
							"id": "mvmxP66rAGu1LJcLO",
							"name": "Disadvantage Delivered (Warp-Deafened: -3 to psychic skill and Warp Empowerment-related rolls, plus an immediate Fright Check on first exposure, -30 pts)",
							"cost_adj": "30%"
						},
						{
							"id": "mAbhhKJxsu5-XIret",
							"name": "Area Effect, 16 yards",
							"cost_adj": "+200%"
						},
