							"amount": 2
						}
					]
				},
				{
					"id": "tob1-35eyNg3WkCZY",
					"name": "Enhanced Dodge",
					"reference": "B51",
					"local_notes": "Lore: Framework.md calls this out by name: superior Aeldari reflexes translate into an Enhanced Dodge for Aspect Warriors specifically, on top of Guardian-tier speed — a Dire Avenger or Howling Banshee weaving through incoming fire in a way no unaugmented human, Guardsman or Guardian, quite manages.\n\nDesign: Enhanced Dodge 1 (B51, 15 points/level).",
					"tags": [
						"Advantage",
						"Physical",
						"Xenos",
						"Aeldari"
					],
					"points_per_level": 15,
					"can_level": true,
					"levels": 1
				}
			]
		},
		{
			"id": "TAOWaPcfKdr-cfcwN",
			"name": "Path of the Warrior",
			"local_notes": "Lore: The path of battle: years, sometimes decades, spent living and training inside an Aspect Shrine, honing one narrow discipline of war to a razor's edge before setting the mantle down and walking away — unless the Path claims them permanently (see Lost to the Path, below).\n\nDesign: Net 0 points, per-Path flavour lens, matching the Ork Klan lens pattern.",
			"tags": [
				"Xenos",
				"Aeldari"
			],
			"children": [
				{
