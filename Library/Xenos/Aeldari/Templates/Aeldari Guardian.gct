							"name": {
								"compare": "is",
								"qualifier": "Tactics"
							},
							"amount": 1
						}
					]
				}
			],
			"disabled": true
		},
		{
			"id": "TrqaIgZ4aHm-aE8MS",
			"name": "Path of the Seer",
			"local_notes": "Lore: The path of prophecy: study under a craftworld's Seer Council, walking the strands of possible futures under supervision before either setting the gift aside or — for the rare few strong and disciplined enough — being claimed by it entirely as a Warlock or Farseer.\n\nDesign: Net 0 points, per-Path flavour lens, matching the Ork Klan lens pattern.",
			"tags": [
				"Xenos",
				"Aeldari"
			],
			"children": [
				{
					"id": "td2tywh2GQWFLlw8v",
					"name": "Seer's Study",
					"local_notes": "Lore: Formal study of the immaterium under a craftworld's Seer Council.\n\nDesign: Perk (B9), +1 to Hidden Lore (the Warp).",
					"tags": [
						"Perk",
