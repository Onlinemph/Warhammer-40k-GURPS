		},
		{
			"id": "sOvUzru1ty6s4TH8c",
			"name": "Broadsword",
			"local_notes": "Lore: A short blade or shock-baton carried as sidearm and drill weapon; a Guardian's melee training is real but secondary to the catapult.\n\nDesign: DX+0 (14) for 2 points, Average (B208).",
			"tags": [
				"Xenos",
				"Aeldari"
			],
			"difficulty": "dx/a",
			"points": 2
		},
		{
			"id": "szfa4LbuS6MW6G_BX",
			"name": "Tactics",
			"local_notes": "Lore: Basic militia drill in holding a line and falling back in good order.\n\nDesign: IQ-1 (11) for 2 points, Hard.",
			"tags": [
				"Xenos",
				"Aeldari"
			],
			"difficulty": "iq/h",
			"points": 2
		},
