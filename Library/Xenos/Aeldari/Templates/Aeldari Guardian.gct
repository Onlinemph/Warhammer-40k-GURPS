				},
				{
					"id": "tx0UoYNFoqyvIDFXC",
					"name": "Cryptic Speech",
					"local_notes": "Lore: A Seer in training already speaks more in omen and riddle than plain sense.\n\nDesign: Quirk (B9), roleplaying flag only.",
					"tags": [
						"Quirk",
						"Xenos",
