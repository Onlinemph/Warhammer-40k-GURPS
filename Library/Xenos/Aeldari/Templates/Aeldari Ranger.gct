		{
			"id": "srvA2IxmBqtNkAn1m",
			"name": "Traps",
			"local_notes": "Lore: Rangers seed the ground they defend, or move through, with unpleasant surprises.\n\nDesign: IQ+1 (13) for 4 points, Average.",
			"tags": [
				"Xenos",
				"Aeldari"
