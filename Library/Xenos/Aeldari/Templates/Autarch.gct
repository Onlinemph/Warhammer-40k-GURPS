						"Aeldari"
					],
					"base_points": 15
				},
				{
					"id": "tl0oKrxEl3V8SIcSy",
					"name": "Weapon Master (Aspect Weapons)",
					"reference": "B99",
					"local_notes": "Lore: Unlike an Exarch, bound to one Aspect's own signature weapon-art, an Autarch has trained seriously across several — Codex background repeatedly shows Autarchs equipped with a mix-and-match loadout no single Aspect Shrine would issue.\n\nDesign: Basic Set Weapon Master, a small related group of weapons (B99), 25 points — one step above the single-weapon 20-point tier Exarch's Mastery uses.",
					"tags": [
						"Advantage",
						"Physical",
						"Xenos",
						"Aeldari"
					],
					"base_points": 25
				},
				{
					"id": "tJfkl5jfVI5V4PvFI",
					"name": "Trained By A Master",
					"reference": "B93",
					"local_notes": "Lore: Formal mastery recognized across every Aspect Shrine an Autarch has passed through on their way to the role.\n\nDesign: Basic Set Trained By A Master (B93), 30 points, matching Exarch's Mastery's own use of this trait.",
					"tags": [
						"Advantage",
						"Mental",
						"Xenos",
						"Aeldari"
					],
					"base_points": 30
				},
				{
					"id": "tWGE2dqTxFV-vPYOD",
					"name": "Enhanced Parry",
					"reference": "B51",
					"local_notes": "Lore: A guard drilled across multiple Aspects' own defensive doctrines.\n\nDesign: Enhanced Parry 1, one weapon group (B51, 5/level, 5 points).",
					"tags": [
						"Advantage",
						"Physical",
						"Xenos",
						"Aeldari"
					],
					"points_per_level": 5,
					"can_level": true,
					"levels": 1
				},
				{
					"id": "trxhIrq-aUduk4pE5",
					"name": "Charisma",
					"reference": "B41",
					"local_notes": "Lore: An Autarch commands a warhost drawn from every Aspect Shrine and Guardian defense force on a craftworld, none of which owe the others any formal obedience — only genuine command presence holds it together.\n\nDesign: Charisma 2 (B41, 5/level, 10 points).",
					"tags": [
						"Advantage",
						"Mental",
						"Xenos",
						"Aeldari"
					],
					"points_per_level": 5,
					"can_level": true,
					"levels": 2
				},
				{
					"id": "txHgoib6pkzzpizqH",
					"name": "Reputation (Legendary Autarch)",
					"reference": "B27",
					"local_notes": "Lore: An Autarch's name travels between craftworlds the way a Chapter Master's does between Imperial fleets.\n\nDesign: Reputation (B27), priced in line with this project's other eyeballed Reputation entries (Ork Warboss's own Reputation, 15 points for +4).",
					"tags": [
						"Advantage",
						"Social",
						"Xenos",
						"Aeldari"
					],
					"base_points": 15,
					"features": [
						{
							"type": "reaction_bonus",
							"situation": "from Aeldari who recognise the Autarch's name and deeds, and a Fright Check-adjacent bonus/penalty for enemies who know it",
							"amount": 4
						}
					]
				},
				{
					"id": "tMB5NpI46o62pOTyJ",
					"name": "Master of Many Paths",
					"local_notes": "Lore: What actually sets an Autarch apart from an Exarch or Farseer is this: they are not lost to any single Path. They carry what every Path taught them forward together, rather than being consumed by one — the mechanical reason this package includes no \"Lost to the Path\" disadvantage at all, unlike Exarch's Mastery and Farseer's Mastery above.\n\nDesign: A 1-point Perk (B100), +1 to any one skill-use roll per session. Homebrew, named to keep it distinct from the Basic Set Versatile advantage (B96, 5 points), which does something different.",
					"tags": [
						"Advantage",
						"Mental",
						"Xenos",
						"Aeldari",
						"Perk"
					],
					"base_points": 1
				}
			]
		},
		{
			"id": "T1y6WCYE1is2C56Wr",
			"name": "Path of the Warrior",
			"local_notes": "Lore: The path of battle: years, sometimes decades, spent living and training inside an Aspect Shrine, honing one narrow discipline of war to a razor's edge before setting the mantle down and walking away — unless the Path claims them permanently (see Lost to the Path, below).\n\nDesign: Net 0 points, per-Path flavour lens, matching the Ork Klan lens pattern.",
			"tags": [
				"Xenos",
				"Aeldari"
			],
			"children": [
				{
					"id": "tk1amq3DUS9onLb_4",
					"name": "Shrine Discipline",
					"local_notes": "Lore: Years spent drilling under an Exarch's eye instil a real, if narrow, tactical sense.\n\nDesign: Perk (B9), +1 to Tactics.",
					"tags": [
						"Perk",
						"Xenos",
						"Aeldari"
					],
					"base_points": 1,
					"features": [
						{
							"type": "skill_bonus",
							"selection_type": "skills_with_name",
							"name": {
								"compare": "is",
								"qualifier": "Tactics"
							},
							"amount": 1
						}
					]
				}
			],
			"disabled": true
		},
		{
			"id": "TMCS7txHula9Y5Jbh",
			"name": "Path of the Outcast",
			"local_notes": "Lore: The path outside the Path: those who leave their craftworld's shielded webway entirely, for a season or for the rest of their life, and walk the wider galaxy as Rangers, Corsairs, or simple wanderers — trading a Craftworld's protection and society for a freedom most Aeldari find unsettling to watch. Gav Thorpe's Path of the Outcast is this project's primary source for the mechanic.\n\nDesign: Net -3 points (1+1-5), the one Path lens with an honest net cost: it trades a real social safety net for real independence, unlike the other three Paths' pure flavour-lens neutrality.",
			"tags": [
				"Xenos",
				"Aeldari"
			],
			"children": [
				{
					"id": "tmtNrCiuIX24Y2pNb",
					"name": "Wanderer's Eye",
					"local_notes": "Lore: Time spent living outside a craftworld's shielded webway sharpens practical survival sense fast.\n\nDesign: Perk (B9), +1 to Survival.",
					"tags": [
						"Perk",
						"Xenos",
						"Aeldari"
					],
					"base_points": 1,
					"features": [
						{
							"type": "skill_bonus",
							"selection_type": "skills_with_name",
							"name": {
								"compare": "is",
								"qualifier": "Survival"
							},
							"amount": 1
						}
					]
				},
				{
					"id": "teEvFbQ-btFmvuDWK",
					"name": "Unblooded Silence",
					"local_notes": "Lore: A Ranger or Corsair's continued survival depends on not being seen first.\n\nDesign: Perk (B9), +1 to Stealth.",
					"tags": [
						"Perk",
						"Xenos",
						"Aeldari"
					],
					"base_points": 1,
					"features": [
						{
							"type": "skill_bonus",
							"selection_type": "skills_with_name",
							"name": {
								"compare": "is",
								"qualifier": "Stealth"
							},
							"amount": 1
						}
					]
				},
				{
					"id": "tRn5No-289nY6HjKe",
					"name": "Social Stigma (Outcast)",
					"reference": "B155",
					"local_notes": "Lore: Craftworld Aeldari who never left the webway regard those who did — Rangers and Corsairs both — with a mix of pity and suspicion: an Outcast has stepped outside the Path structure that keeps Emotional Intensity in check, and it shows.\n\nDesign: Basic Set Social Stigma tier (B155), -5 points, scoped to Craftworld society.",
					"tags": [
						"Disadvantage",
						"Social",
						"Xenos",
						"Aeldari"
					],
					"base_points": -5
				}
			],
			"disabled": true
		}
	],
