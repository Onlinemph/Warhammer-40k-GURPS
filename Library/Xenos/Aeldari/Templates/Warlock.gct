	"skills": [
		{
			"id": "sorjRbcu12Tm3YT92",
			"name": "Psyniscience",
			"local_notes": "Lore: The trained (or instinctive) sense of \"something wrong\" in a presence, place, or object touched by the warp — a chill in a corridor, a servitor's dead eyes going wrong. Named for the Dark Heresy/Only War skill of the same purpose (Psyniscience), used here for calibration only; the GURPS build is original.\n\nDesign: New skill per framework.md (\"New skills only when nothing fits\"). Per/H, Talent-affected: characters with a Psyker Talent (see the psyker power library — not part of this file) get it at a discount per that trait's rules and may default it from Per at a penalty; an unaugmented human without any psychic Talent cannot default into it at all (there is nothing latent to sense with) and must buy it as an unusual background purchase, if a GM allows it at all — most unaugmented Imperial citizens simply never take this skill.",
			"tags": [
				"Mental",
				"Imperium",
				"Psionic"
			],
			"difficulty": "per/h",
			"points": 4
		},
		{
			"id": "s0pUKB-k6QSHHGC-3",
			"name": "Meditation",
			"local_notes": "Lore: The discipline that keeps a Warlock's gift steady under fire, without which no Aeldari psyker lasts long.\n\nDesign: IQ+0 (13) for 4 points, Hard.",
			"tags": [
				"Xenos",
				"Aeldari",
				"Psyker"
			],
			"difficulty": "iq/h",
			"points": 4
		},
		{
			"id": "sI7VFJoiAa4t0f-xr",
			"name": "Hidden Lore",
			"local_notes": "Lore: A Warlock's real, Seer-Council-taught understanding of the immaterium, well beyond a Guardian's folk knowledge.\n\nDesign: IQ+1 (14) for 4 points, Average.",
			"tags": [
				"Xenos",
				"Aeldari",
				"Psyker"
			],
			"specialization": "(the Warp)",
			"difficulty": "iq/a",
			"points": 4
		},
		{
			"id": "s8p9EeuxV-F73ouyC",
			"name": "Guns",
			"local_notes": "Lore: A Warlock still carries and uses a shuriken catapult like any other Guardian.\n\nDesign: DX+2 (16) for 4 points, Easy.",
			"tags": [
				"Xenos",
				"Aeldari"
			],
			"specialization": "Rifle",
			"difficulty": "dx/e",
			"points": 4
		},
		{
			"id": "sA4W8x0D5W_h1NDHO",
			"name": "Broadsword",
			"local_notes": "Lore: The witchblade, a Warlock's own force weapon, carried and drilled with as seriously as any Aspect Warrior's blade.\n\nDesign: DX+2 (16) for 8 points, Average; the framework's las/plasma/melta and chainsword/power-sword weapon-skill table places force weapons on Broadsword/Staff/Axe, matched here to Broadsword.",
			"tags": [
				"Xenos",
				"Aeldari"
			],
			"difficulty": "dx/a",
			"points": 8
		},
		{
			"id": "s749DzwtFX-vKLF-E",
			"name": "Leadership",
			"local_notes": "Lore: A Warlock is typically the senior figure attached to a Guardian defense force or Aspect warhost detachment.\n\nDesign: IQ+1 (14) for 4 points, Average.",
			"tags": [
				"Xenos",
				"Aeldari"
			],
			"difficulty": "iq/a",
			"points": 4
		},
		{
			"id": "shfoBykoGNuP6_TgQ",
			"name": "Tactics",
			"local_notes": "Lore: Enough battlefield sense to know when to spend a Rune of Battle and when to hold it.\n\nDesign: IQ-1 (12) for 4 points, Hard.",
			"tags": [
				"Xenos",
				"Aeldari"
			],
			"difficulty": "iq/h",
			"points": 4
