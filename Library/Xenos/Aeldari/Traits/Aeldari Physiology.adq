					]
				},
				{
					"id": "t_IlIz5Cs5nOFcOM0",
					"name": "Social Stigma (Outcast)",
					"reference": "B155",
					"local_notes": "Lore: Craftworld Aeldari who never left the webway regard those who did — Rangers and Corsairs both — with a mix of pity and suspicion: an Outcast has stepped outside the Path structure that keeps Emotional Intensity in check, and it shows.\n\nDesign: Basic Set Social Stigma tier (B155), -5 points, scoped to Craftworld society.",
					"tags": [
						"Disadvantage",
						"Social",
						"Xenos",
						"Aeldari"
					],
					"base_points": -5
				}
			],
			"disabled": true
		},
		{
			"id": "T9IplE9xSYx9Yed6L",
			"name": "Path of the Artisan",
			"local_notes": "Lore: The path of making: the quieter majority of Aeldari lives, spent shaping wraithbone, weaving, composing, or otherwise building and maintaining the culture the Warrior and Seer paths exist to protect. Rarely a PC's own Path, but the backdrop every Guardian and Aspect Warrior is ultimately defending.\n\nDesign: Net 0 points, per-Path flavour lens, matching the Ork Klan lens pattern.",
			"tags": [
				"Xenos",
				"Aeldari"
			],
			"children": [
				{
					"id": "tldojp2FRCyDnuqjY",
					"name": "Craftworker's Hand",
					"local_notes": "Lore: A craftworld runs on its artisans' work as much as its warriors' — wraithbone shaping, weaving, sculpture, music.\n\nDesign: Perk (B9), +1 to Artist.",
					"tags": [
						"Perk",
						"Xenos",
						"Aeldari"
					],
					"base_points": 1,
					"features": [
