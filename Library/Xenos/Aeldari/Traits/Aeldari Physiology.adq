									"name": "Armor Divisor (2)",
									"cost_adj": "+50%"
								},
								{
									"id": "mPN8D2TU7V6Ff4zHS",
									"name": "Warp Sorcery",
									"cost_adj": "-20%"
								},
								{
									"id": "m7ASMyk_gJcS09NbA",
									"name": "Perils of the Warp (Aeldari Runes)",
									"cost_adj": "-5%"
								}
							],
							"points_per_level": 5,
							"can_level": true,
							"levels": 7
						},
						{
							"id": "tUQA67KABVVomUoqe",
							"name": "Embolden",
							"local_notes": "Lore: A wash of certainty over a willing ally that drives out fear for a few crucial moments.\n\nDesign: Affliction (10) delivering a 4-point Fearlessness 2 advantage (B55, 2/level; +10% per point, B36: +40%), Warp Sorcery (-20%), Perils (Aeldari Runes, -5%). Net +15%. Full modified cost: 10 x 1.15 = 11.5, rounded up to 12 points (discounted to a fifth as the cheaper alternative ability, so the container costs 62 + 3 = 65); needs Aeldari Warp Empowerment level 1 (cap 20) at its full-price rate.",
							"tags": [
								"Advantage",
								"Mental",
								"Xenos",
								"Aeldari",
								"Psyker"
							],
							"modifiers": [
