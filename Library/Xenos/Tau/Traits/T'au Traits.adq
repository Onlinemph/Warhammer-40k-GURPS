							"attribute": "basic_move",
							"amount": 2
						}
					]
				},
				{
					"id": "t0er3PHcTLu82GI56",
					"name": "Sharp Beak (Kroot)",
					"reference": "B91",
					"local_notes": "Peck: thr-1 piercing+ (B91).\n\nLore: Kroot have a hard, hooked beak that tears meat.\n\nDesign: Sharp Beak (B91), 1 point. The framework calls this 'Sharp Teeth'; a beak is its Basic Set equivalent.",
					"tags": [
						"Advantage",
						"Physical",
						"Xenos",
						"T'au",
						"Kroot"
					],
					"base_points": 1,
					"weapons": [
						{
							"id": "w2gKhODT_kLJ3t_YF",
							"sv": 1,
							"damage": {
								"type": "pi+",
								"st": "thr",
								"base": "-1"
							},
							"reach": "C",
							"usage": "Peck",
							"defaults": [
								{
									"type": "dx",
									"modifier": 0
								},
								{
									"type": "skill",
									"name": {
										"compare": "is",
										"qualifier": "Brawling"
									}
								}
							]
						}
					]
				},
				{
					"id": "tz1s1jIoqtYnkI5nr",
					"name": "Acute Taste & Smell (Kroot)",
					"reference": "B35",
					"local_notes": "+2 to Taste/Smell rolls, including tracking by scent.\n\nLore: Kroot are hunters that follow scent trails and judge meat by taste.\n\nDesign: Acute Taste & Smell 2 (B35, 2/level) = 4 points.",
					"tags": [
						"Advantage",
						"Physical",
						"Xenos",
						"T'au",
						"Kroot"
					],
					"points_per_level": 2,
					"can_level": true,
					"levels": 2
				},
				{
					"id": "tkllY2F_RLIitaUqU",
					"name": "Born Climber",
					"reference": "B100",
					"local_notes": "+1 to Climbing.\n\nLore: Kroot are agile climbers and ambushers.\n\nDesign: Perk (B100), +1 to Climbing, 1 point.",
					"tags": [
						"Perk",
						"Xenos",
						"T'au",
						"Kroot"
					],
					"base_points": 1,
					"features": [
						{
							"type": "skill_bonus",
							"selection_type": "skills_with_name",
							"name": {
								"compare": "is",
								"qualifier": "Climbing"
							},
							"amount": 1
						}
					]
				},
				{
					"id": "tAbq3z3f-YTsfsjY7",
					"name": "Born Tracker",
					"reference": "B100",
					"local_notes": "+1 to Tracking.\n\nLore: Kroot are famed as trackers and scouts.\n\nDesign: Perk (B100), +1 to Tracking, 1 point.",
					"tags": [
						"Perk",
						"Xenos",
						"T'au",
						"Kroot"
					],
					"base_points": 1,
					"features": [
						{
							"type": "skill_bonus",
							"selection_type": "skills_with_name",
							"name": {
								"compare": "is",
								"qualifier": "Tracking"
							},
							"amount": 1
						}
					]
				},
				{
					"id": "ti-I_4CoN1L77Y3dQ",
					"name": "Genetic Absorption",
					"local_notes": "No per-meal stat change. Over a campaign a kindred that has eaten a strong enemy's flesh may gain a small trait (GM's call and story-driven); Shapers guide which.\n\nLore: Kroot absorb genetic traits from the flesh they eat: over generations a kindred takes on the strengths of what it kills. Codex: T'au Empire background.\n\nDesign: A 0-point feature at the kindred level, per framework.md's direction: not a mechanical per-meal effect but a story lever.",
					"tags": [
						"Feature",
						"Xenos",
						"T'au",
						"Kroot"
					],
					"base_points": 0
				}
			]
		},
		{
			"id": "T4zrNS2GY7TjH_fug",
			"name": "Kroot Kindred",
			"local_notes": "Lore: Kroot live and fight in kindreds: extended clans that move as a body, led by a Shaper, who hire out to the T'au for payment and the chance to eat the strong. Kroot eating habits, including eating the slain, are the most commented-on thing about them. Codex: T'au Empire background.\n\nDesign: Sense of Duty (Kindred) -5 + Odious Personal Habit -5 = -10 points.",
			"tags": [
				"Disadvantage",
				"Mental",
				"Xenos",
				"T'au",
				"Kroot"
			],
			"container_type": "meta_trait",
			"children": [
				{
					"id": "twh9DayQKGV5UE6AJ",
					"name": "Sense of Duty (Kindred)",
					"reference": "B153",
					"local_notes": "Will not leave kin behind or betray the kindred; self-control roll to put self first.\n\nLore: A Kroot's loyalty is to the kindred first.\n\nDesign: Sense of Duty (B153), Small Group -5.",
					"tags": [
						"Disadvantage",
						"Mental",
						"Xenos",
						"T'au",
						"Kroot"
					],
					"modifiers": [
						{
							"id": "mh556dRjCfQNGC5bJ",
							"name": "Small Group (the kindred)",
							"reference": "B153",
							"cost_adj": "-5"
						}
					]
				},
				{
					"id": "txB45XqROXlnf2Z_S",
					"name": "Odious Personal Habit (Eats the Slain)",
					"reference": "B22",
					"local_notes": "-1 reaction from those who find it disgusting (most non-Kroot, including many T'au).\n\nLore: Kroot eat their kills, including the dead of other species.\n\nDesign: Odious Personal Habit 1 level (B22, -5/level) = -5 points.",
					"tags": [
						"Disadvantage",
						"Social",
						"Xenos",
						"T'au",
						"Kroot"
					],
					"points_per_level": -5,
					"can_level": true,
					"levels": 1
				}
			]
		},
		{
			"id": "TaOoM_53Zt9WDuYbT",
			"name": "Kroot Shaper Lens",
			"local_notes": "Lore: A Shaper is a Kroot kindred's leader and priest of its evolution: it decides what the kindred eats, and so what it will become. Shapers are larger and sharper than their kin. Codex: T'au Empire background.\n\nDesign: Attribute Modifiers (Kroot Shaper) 50 + Status 1 (5) = 55 points.",
			"tags": [
				"Advantage",
				"Mental",
				"Xenos",
				"T'au",
				"Kroot"
			],
			"container_type": "meta_trait",
			"children": [
				{
					"id": "tOa1RtTqKEw_xTIh7",
					"name": "Attribute Modifiers (Kroot Shaper)",
					"local_notes": "ST +1, IQ +2, HT +1, Per -2 (net of the Kroot Physiology bonus).\n\nDesign: Over Kroot Physiology: ST 13, DX 13, IQ 11, HT 12, HP 13, Per 13, Will 12, Move 8. ST +1 (10), IQ +2 (40), HT +1 (10), Per -2 (-10, cancelling the rise from IQ so Per stays 13) = 50. Basic Speed (13+12)/4 = 6.25, Move 6 + 2 = 8, HP 13 = ST 13.",
					"tags": [
						"Physical",
						"Xenos",
						"T'au",
						"Kroot"
					],
					"base_points": 50,
					"features": [
						{
							"type": "attribute_bonus",
							"attribute": "st",
							"amount": 1
						},
						{
							"type": "attribute_bonus",
							"attribute": "iq",
							"amount": 2
						},
						{
							"type": "attribute_bonus",
							"attribute": "ht",
							"amount": 1
						},
						{
							"type": "attribute_bonus",
							"attribute": "per",
							"amount": -2
						}
					]
				},
				{
					"id": "tDtBeKVYS19M1R_vw",
					"name": "Status (Kroot Shaper)",
					"reference": "B28",
					"local_notes": "Status 1 among the kindred; Shapers' word decides.\n\nLore: A Shaper leads the kindred and speaks for it.\n\nDesign: Status (B28, 5/level), 1 level = 5 points.",
					"tags": [
						"Advantage",
						"Social",
						"Xenos",
						"T'au",
						"Kroot"
					],
					"points_per_level": 5,
					"can_level": true,
					"levels": 1
				}
			]
		},
		{
			"id": "Tv-gi9kSxKVBjQvNm",
			"name": "Vespid Physiology",
			"local_notes": "Lore: The Vespid are winged, insectoid mercenaries from a distant world whom the T'au hire for their flight and firepower. They are led by Strain Leaders, and their Stingwings fire neutron blasters powered by crystals from their homeworld, reportedly hard for others to use. Codex: T'au Empire background, Vespid Stingwings.\n\nDesign: Attribute Modifiers (Vespid) 70 + Flight (Winged) 30 + Enhanced Move (Air) 1/2 10 + Chitin (Vespid) 125 = 235 points, framework.md's Vespid Stingwing line before training. Chitin is DR 25 (a hard insectoid exoskeleton, modelled on the Tyranid Termagant's light chitin; the exact lore figure is thin, so it is set at the flak-and-a-bit end rather than carapace class); it was added after combat testing showed a Stingwing with no natural armour at all. Not priced, for lack of lore confidence: compound-eye vision (Peripheral Vision) and language limits. The crystal link to the neutron blaster is equipment, not a trait.",
			"tags": [
				"Advantage",
				"Physical",
				"Xenos",
				"T'au",
				"Vespid"
			],
			"container_type": "ancestry",
			"children": [
				{
					"id": "ts912dAcy-r9CuWRQ",
					"name": "Attribute Modifiers (Vespid)",
					"local_notes": "ST +1, DX +3, IQ -2, HT +1, Per +4, Will +2.\n\nDesign: Framework Vespid line: ST 11, DX 13, IQ 8, HT 11, HP 11, Per 12, Will 10, Move 6. ST +1 (10), DX +3 (60), IQ -2 (-40), HT +1 (10), Per +4 (20, so Per 12 with IQ 8), Will +2 (10) = 70. Basic Speed (13+11)/4 = 6.0, Move 6, HP 11 = ST 11.",
					"tags": [
						"Physical",
						"Xenos",
						"T'au",
						"Vespid"
					],
					"base_points": 70,
					"features": [
						{
							"type": "attribute_bonus",
							"attribute": "st",
							"amount": 1
						},
						{
							"type": "attribute_bonus",
							"attribute": "dx",
							"amount": 3
						},
						{
							"type": "attribute_bonus",
							"attribute": "iq",
							"amount": -2
						},
						{
							"type": "attribute_bonus",
							"attribute": "ht",
							"amount": 1
						},
						{
							"type": "attribute_bonus",
							"attribute": "per",
							"amount": 4
						},
						{
							"type": "attribute_bonus",
							"attribute": "will",
							"amount": 2
						}
					]
				},
				{
					"id": "t7Fv9-0a1x4F1Y8J2",
					"name": "Flight (Vespid Wings)",
					"reference": "B56",
					"local_notes": "Air Move is Basic Speed x 2, 12 for a Stingwing.\n\nLore: Vespid fly on real wings.\n\nDesign: Flight (B56, 40 points) with Winged -25%: 40 x 0.75 = 30 points.",
					"tags": [
						"Advantage",
						"Physical",
						"Xenos",
						"T'au",
						"Vespid"
					],
					"modifiers": [
						{
							"id": "m872Z86ZJYNoXeM8q",
							"name": "Winged",
							"reference": "B56",
							"local_notes": "Needs room to spread the wings; a wing hit can ground them.",
							"cost_adj": "-25%"
						}
					],
					"base_points": 40
				},
				{
					"id": "t9yigRhxx0SUhgJWf",
					"name": "Enhanced Move (Air) (Vespid)",
					"reference": "B52",
					"local_notes": "Top speed in flight x1.5: 18 for a Stingwing.\n\nLore: Vespid dive and strafe at speed.\n\nDesign: Enhanced Move (Air) 1/2 (B52, 20/level = 10 points). Air Move 12, top speed 18, meeting framework.md's 'Air 16+'.",
					"tags": [
						"Advantage",
						"Physical",
						"Xenos",
						"T'au",
						"Vespid"
					],
					"points_per_level": 20,
					"can_level": true,
					"levels": 0.5
				},
				{
					"id": "tOqxgl4luDdxiNcxx",
					"name": "Chitin (Vespid)",
					"reference": "B46",
					"local_notes": "DR 25, all locations. Weak Points 7 (thin, gappy plates and wing joints): on a hit that fails to penetrate, roll 3d; 7 or less halves DR (13, rounded down) against that hit. Compound eyes run at DR 12 (roughly half the body DR) rather than 25.\n\nLore: Vespid bodies are covered in a hard chitinous shell, which is why the T'au use them as skirmishers in the open. Codex: T'au Empire background describes them as insectoid; the exact toughness is not stated, so this is a modest figure.\n\nDesign: Damage Resistance (B46, 5/level, all locations), 25 levels = 125 points, at the same DR and Weak Points as this project's Tyranid Termagant chitin (a light exoskeleton, framework.md's flak-tier Weak Points 7).",
					"tags": [
						"Advantage",
						"Physical",
						"Xenos",
						"T'au",
						"Vespid"
					],
					"points_per_level": 5,
					"can_level": true,
					"levels": 25,
					"features": [
						{
							"type": "dr_bonus",
							"locations": [
								"all"
							],
							"amount": 25
						}
					]
				}
			]
		},
		{
			"id": "Tk8SO_tQpVDPW2QUO",
			"name": "Vespid Strain",
			"local_notes": "Lore: Vespid fight in strains under a Strain Leader and answer to it before any employer. Codex: T'au Empire background.\n\nDesign: Sense of Duty (Strain) -5 points.",
			"tags": [
				"Disadvantage",
				"Mental",
				"Xenos",
				"T'au",
				"Vespid"
			],
			"container_type": "meta_trait",
			"children": [
				{
					"id": "t0EoMlx1veo2g1ZD0",
					"name": "Sense of Duty (Strain)",
					"reference": "B153",
					"local_notes": "Will not desert or endanger the strain; self-control roll to put self first.\n\nLore: A Vespid's first loyalty is to its strain and Strain Leader.\n\nDesign: Sense of Duty (B153), Small Group -5.",
					"tags": [
						"Disadvantage",
						"Mental",
						"Xenos",
						"T'au",
						"Vespid"
					],
					"modifiers": [
						{
							"id": "m9tXWwvgEvyHjpIt1",
							"name": "Small Group (the strain)",
							"reference": "B153",
							"cost_adj": "-5"
						}
					]
				}
			]
		},
		{
			"id": "TyooSYGAlAnBHg2ZA",
			"name": "Drone Chassis",
			"local_notes": "Small hovering machine with a simple, obedient AI, built and tended by the Earth caste and controlled by a Shas'ui or battlesuit pilot. No hands, no legs, no sleep, no fear, no initiative. Ground Move does not apply: use Air Move. A drone's armour is its casing (Drone Casing).\n\nLore: T'au drones are small anti-gravity machines with simple learning intelligence: gun, marker, shield and recon drones, and more. They are not persons: they follow orders, learn slowly, and have no will of their own, and the T'au treat them as tools and comrades in equal measure. Background across Codex: T'au Empire editions (the drone AI is described as non-sentient).\n\nDesign: Attribute Modifiers -62 + Machine Body 25 + Flight (Grav) 40 + No Legs (Aerial) 0 + No Manipulators -50 + Machine Mind -90 = -137 points, following the Combat Servitor precedent for construct NPCs (negative subtotals are expected; see the Servitor template). Built from the Basic Set's own Machine (B263) and Automaton (B263) meta-traits, with Slave Mentality and Reprogrammable for the T'au's obedient, controller-driven AI.",
			"tags": [
				"Advantage",
				"Physical",
				"Xenos",
				"T'au",
				"Drone"
			],
			"container_type": "ancestry",
			"children": [
				{
					"id": "t3xunGUItkcmfy53_",
					"name": "Attribute Modifiers (Drone)",
					"local_notes": "SM -2, ST -2, IQ -4, Per +4, Will +2.\n\nDesign: Gun drone line (drafter's, no framework figure): ST 8, DX 10, IQ 6, HT 10, HP 8, Per 10, Will 8. SM -2 (a drone about a yard across, carries no point cost, as for Gretchin and Termagants), ST -2 (10/level, with the 40% discount No Manipulators grants to ST and DX (B145): -20 x 0.6 = -12), IQ -4 (-80), Per +4 over IQ (20, sensors), Will +2 over IQ (10) = -62. DX and HT stay 10; HP 8 = ST 8.",
					"tags": [
						"Physical",
						"Xenos",
						"T'au",
						"Drone"
					],
					"base_points": -62,
					"features": [
						{
							"type": "attribute_bonus",
							"attribute": "sm",
							"amount": -2
						},
						{
							"type": "attribute_bonus",
							"attribute": "st",
							"amount": -2
						},
						{
							"type": "attribute_bonus",
							"attribute": "iq",
							"amount": -4
						},
						{
							"type": "attribute_bonus",
							"attribute": "per",
							"amount": 4
						},
						{
							"type": "attribute_bonus",
							"attribute": "will",
							"amount": 2
						}
					]
				},
				{
					"id": "TH1SmP6MbyXHQemzO",
					"name": "Machine Body",
					"local_notes": "No blood, unliving wound modifiers, immune to metabolic hazards (disease, poison, suffocation), no FP, cannot heal on its own; repaired by Mechanic or Armoury rolls. Power cell gives about eight hours of operation.\n\nLore: A drone is a machine, not an animal.\n\nDesign: Machine (B263) built as its three costed parts: Injury Tolerance 25, Resistant 30, Unhealing -30 = 25.",
					"tags": [
						"Advantage",
						"Physical",
						"Xenos",
						"T'au",
						"Drone"
					],
					"container_type": "meta_trait",
					"children": [
						{
							"id": "tVKe2FOrwDVa0eHNH",
							"name": "Injury Tolerance (No Blood, Unliving)",
							"reference": "B60",
							"local_notes": "No blood; wound modifiers as unliving (impaling and pi++ x1, pi+ x1/2, pi x1/3, pi- x1/5).\n\nLore: A machine does not bleed or suffer shock.\n\nDesign: Injury Tolerance (B60), No Blood 5 + Unliving 20 = 25 points.",
							"tags": [
								"Advantage",
								"Physical",
								"Xenos",
								"T'au",
								"Drone"
							],
							"modifiers": [
								{
									"id": "mmWSRCDpdRfnQsMJI",
									"name": "No Blood",
									"reference": "B61",
									"cost_adj": "5"
								},
								{
									"id": "mz7Daa6EvyrE8zvar",
									"name": "Unliving",
									"reference": "B61",
									"cost_adj": "20"
								}
							]
						},
						{
							"id": "tZnr2PEKkEYfeQC_Q",
							"name": "Resistant to Metabolic Hazards (Machine)",
							"reference": "B81",
							"local_notes": "Immune to disease, poison, suffocation and other metabolic hazards.\n\nLore: Nothing here has a metabolism.\n\nDesign: Resistant (B81), Metabolic Hazards 30, Immunity x1 = 30 points, same as the Basic Set Machine.",
							"tags": [
