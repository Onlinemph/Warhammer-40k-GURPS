						{
							"id": "t58lplWHMPsRIAdTz",
							"name": "Unhealing (Total)",
							"reference": "B160",
							"local_notes": "Never heals on its own; repair is a Mechanic or Armoury job.\n\nLore: Drones are fixed by Earth caste, not by rest.\n\nDesign: Unhealing (Total) (B160), -30 points.",
							"tags": [
