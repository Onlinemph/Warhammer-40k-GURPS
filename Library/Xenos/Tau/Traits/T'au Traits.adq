							"id": "tQfugFIEMs41GDKKr",
							"name": "Hidebound",
							"reference": "B138",
							"local_notes": "-2 on any task needing creativity.\n\nLore: Drones follow their programming.\n\nDesign: Hidebound (B138), -5.",
							"tags": [
								"Disadvantage",
								"Mental",
								"Xenos",
								"T'au",
								"Drone"
							],
							"base_points": -5
						},
						{
							"id": "tnzaSVhb1XDUi54Li",
							"name": "Incurious",
							"reference": "B140",
							"local_notes": "Ignores the strange unless ordered otherwise.\n\nLore: Drones have no curiosity.\n\nDesign: Incurious (B140), -5.",
							"tags": [
								"Disadvantage",
								"Mental",
								"Xenos",
								"T'au",
								"Drone"
							],
							"base_points": -5
						},
						{
							"id": "twTv-NYez91DoU8s0",
							"name": "Low Empathy",
							"reference": "B142",
							"local_notes": "Cannot read or care about others' feelings.\n\nLore: Drones do not understand emotion.\n\nDesign: Low Empathy (B142), -20.",
