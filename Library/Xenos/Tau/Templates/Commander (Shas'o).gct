		{
			"id": "sHG3qlQciC1mokzEl",
			"name": "Leadership",
			"reference": "B204",
			"local_notes": "Lore: Commanding a cadre and its Shas'ui and Shas'vre.\n\nDesign: IQ+5 (19) for 20 points, Average.",
			"tags": [
				"Xenos",
