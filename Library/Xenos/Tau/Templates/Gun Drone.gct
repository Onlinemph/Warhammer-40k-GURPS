									"id": "mp-JvISRPu1H5XJZq",
									"name": "Immunity",
									"reference": "B81",
									"cost_adj": "x1"
								}
							]
						},
						{
							"id": "tDyroExvJMn0HtR8I",
							"name": "Unhealing (Total)",
							"reference": "B160",
							"local_notes": "Never heals on its own; repair is a Mechanic or Armoury job.\n\nLore: Drones are fixed by Earth caste, not by rest.\n\nDesign: Unhealing (Total) (B160), -30 points.",
							"tags": [
								"Disadvantage",
								"Physical",
								"Xenos",
								"T'au",
								"Drone"
							],
							"base_points": -30
						}
					]
				},
				{
					"id": "t-Gc80KwUwcGgv6a2",
					"name": "Flight (Grav Repulsors)",
					"reference": "B56",
					"local_notes": "Air Move is Basic Speed x 2: 10 for a gun drone. Hovers; superscience (^) grav repulsors.\n\nLore: T'au drones hover on grav repulsors; the framework marks grav systems as the T'au's one superscience exception.\n\nDesign: Flight (B56), 40 points, no Winged limitation (grav, not wings). Marked ^ by the framework rule for T'au grav technology.",
					"tags": [
						"Advantage",
						"Physical",
						"Xenos",
						"T'au",
						"Drone"
					],
					"base_points": 40
				},
				{
					"id": "tlqjbbRfCg9UtxSXy",
					"name": "No Legs (Aerial)",
					"reference": "B145",
					"local_notes": "No legs; it flies. Ground Move does not apply.\n\nLore: A drone is a hovering shell.\n\nDesign: No Legs (Aerial) (B145), 0 points.",
					"tags": [
						"Feature",
						"Xenos",
						"T'au",
						"Drone"
					],
					"base_points": 0
				},
				{
					"id": "tg3-agvr-M3ByabfZ",
					"name": "No Manipulators",
					"reference": "B145",
					"local_notes": "Cannot manipulate objects; guns are built in. ST and DX cost 40% less (B145).\n\nLore: A gun drone has weapons but no hands.\n\nDesign: No Manipulators (B145), -50 points; the ST cost reduction is applied in Attribute Modifiers (Drone).",
					"tags": [
						"Disadvantage",
						"Physical",
						"Xenos",
						"T'au",
						"Drone"
					],
					"base_points": -50
				},
				{
					"id": "TRxHiQOkF9hIqQdj-",
					"name": "Machine Mind (Drone AI)",
					"local_notes": "Takes orders, does nothing on its own initiative, cannot improvise, feels nothing. Follows its controller (a Shas'ui or pilot, or the fire team's network); another controller can be slotted in.\n\nLore: Drones are simple learning AIs: obedient, unimaginative, and without emotions the T'au recognise as their own. Codex: T'au Empire background.\n\nDesign: Slave Mentality -40 + Hidebound -5 + Incurious -5 + Low Empathy -20 + No Sense of Humor -10 + Reprogrammable -10 = -90. Slave Mentality replaces the Automaton's Heteronomy (same cost, B154); Incurious is priced at the library's -5 base rather than -10.",
					"tags": [
						"Disadvantage",
						"Mental",
						"Xenos",
						"T'au",
						"Drone"
					],
					"container_type": "meta_trait",
					"children": [
						{
							"id": "tJ8O92Fxs1wIzJhLy",
							"name": "Slave Mentality",
							"reference": "B154",
							"local_notes": "Cannot act without orders; obeys its controller.\n\nLore: Drones do what they are told.\n\nDesign: Slave Mentality (B154), -40 points.",
							"tags": [
								"Disadvantage",
								"Mental",
								"Xenos",
								"T'au",
								"Drone"
							],
							"base_points": -40
						},
						{
							"id": "tGxZX4-CVQ10voiKo",
							"name": "Hidebound",
							"reference": "B138",
							"local_notes": "-2 on any task needing creativity.\n\nLore: Drones follow their programming.\n\nDesign: Hidebound (B138), -5.",
							"tags": [
								"Disadvantage",
								"Mental",
								"Xenos",
								"T'au",
								"Drone"
							],
							"base_points": -5
						},
						{
							"id": "tqiyDXw7ezkRcIRx-",
							"name": "Incurious",
							"reference": "B140",
							"local_notes": "Ignores the strange unless ordered otherwise.\n\nLore: Drones have no curiosity.\n\nDesign: Incurious (B140), -5.",
							"tags": [
								"Disadvantage",
								"Mental",
								"Xenos",
								"T'au",
								"Drone"
							],
							"base_points": -5
						},
						{
							"id": "t8HacKaP2D13pWDZP",
							"name": "Low Empathy",
							"reference": "B142",
							"local_notes": "Cannot read or care about others' feelings.\n\nLore: Drones do not understand emotion.\n\nDesign: Low Empathy (B142), -20.",
							"tags": [
								"Disadvantage",
								"Mental",
								"Xenos",
								"T'au",
								"Drone"
							],
							"base_points": -20
						},
						{
							"id": "tjGqhhMi8-bo9g8yT",
							"name": "No Sense of Humor",
							"reference": "B146",
							"local_notes": "Does not get jokes.\n\nLore: Drones have no humour.\n\nDesign: No Sense of Humor (B146), -10.",
							"tags": [
								"Disadvantage",
								"Mental",
								"Xenos",
								"T'au",
								"Drone"
							],
							"base_points": -10
						},
						{
							"id": "tG19N0qKU0_lcxbOD",
							"name": "Reprogrammable",
							"reference": "B150",
							"local_notes": "Another controller or a hostile hacker can rewrite its orders.\n\nLore: Drone control networks can be re-slaved.\n\nDesign: Reprogrammable (B150), -10.",
							"tags": [
								"Disadvantage",
								"Mental",
								"Xenos",
								"T'au",
								"Drone"
							],
							"base_points": -10
						}
					]
				}
			]
		},
		{
			"id": "tF5zZ8N2DsWbJZ_fN",
			"name": "Drone Casing (Light)",
			"reference": "B46",
			"local_notes": "DR 30 all round, flak-class. Sensor eyes are not armoured separately (treat as DR 15).\n\nLore: A gun drone's casing is light composite: tougher than a Fire Warrior's flesh, less than his armour. Background: the drone is meant to be expendable.\n\nDesign: Damage Resistance (B46-47, 5/level), 30 levels = 150 points. DR 30 matches the framework's flak anchor; the drone is designed to be cheap, so it is not carapace. Other drone types override the levels.",
			"tags": [
				"Advantage",
				"Physical",
				"Xenos",
				"T'au",
				"Drone"
			],
			"points_per_level": 5,
			"can_level": true,
			"levels": 30,
			"features": [
				{
					"type": "dr_bonus",
					"locations": [
						"all"
					],
					"amount": 30
				}
			]
		}
	],
