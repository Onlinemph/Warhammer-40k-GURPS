				},
				{
					"id": "tEDOBvSiL57igEn-m",
					"name": "Acute Taste & Smell (Kroot)",
					"reference": "B35",
					"local_notes": "+2 to Taste/Smell rolls, including tracking by scent.\n\nLore: Kroot are hunters that follow scent trails and judge meat by taste.\n\nDesign: Acute Taste & Smell 2 (B35, 2/level) = 4 points.",
					"tags": [
						"Advantage",
						"Physical",
						"Xenos",
						"T'au",
						"Kroot"
					],
					"points_per_level": 2,
					"can_level": true,
					"levels": 2
				},
				{
					"id": "tjtm0Xf-VzXZGQt_z",
					"name": "Born Climber",
					"reference": "B100",
					"local_notes": "+1 to Climbing.\n\nLore: Kroot are agile climbers and ambushers.\n\nDesign: Perk (B100), +1 to Climbing, 1 point.",
					"tags": [
						"Perk",
						"Xenos",
						"T'au",
						"Kroot"
					],
					"base_points": 1,
					"features": [
						{
