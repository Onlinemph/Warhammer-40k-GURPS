							"selection_type": "skills_with_name",
							"name": {
								"compare": "is",
								"qualifier": "Climbing"
							},
							"amount": 1
						}
					]
				},
				{
					"id": "toQiuxxRJ6VS3-5nz",
					"name": "Born Tracker",
					"reference": "B100",
					"local_notes": "+1 to Tracking.\n\nLore: Kroot are famed as trackers and scouts.\n\nDesign: Perk (B100), +1 to Tracking, 1 point.",
					"tags": [
						"Perk",
						"Xenos",
						"T'au",
						"Kroot"
					],
					"base_points": 1,
					"features": [
						{
							"type": "skill_bonus",
