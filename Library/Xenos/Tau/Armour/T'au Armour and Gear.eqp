						}
					],
					"quantity": 1,
					"equipped": true
				},
				{
					"id": "eSWCAPa-7U5EjGSJ2",
					"description": "Hardpoint Mounts (Broadside Pattern)",
					"local_notes": "Two weapon hardpoints (one able to carry a heavy weapon such as the heavy rail rifle) and one support hardpoint. Weapons and systems are separate items and are not included.\n\nLore: Broadsides pair a heavy rail rifle with a secondary missile weapon and support systems.\n\nDesign: Mounting, feed and power hardware, priced apart from what it carries.",
					"tech_level": "11",
