			"points": 4
		},
		{
			"id": "sal-k2qH1phC5kPOA",
			"name": "Brawling",
			"local_notes": "Lore: A last-resort fallback if a Lychguard's weapon is somehow lost.\n\nDesign: DX+1 (13) for 2 points, Easy.",
			"tags": [
				"Xenos",
				"Necrons"
			],
			"difficulty": "dx/e",
			"points": 2
		},
		{
			"id": "sjb6SFGpNg9JAoFnR",
			"name": "Tactics",
			"local_notes": "Lore: Enough grasp of a fight's shape to place itself correctly around its charge.\n\nDesign: IQ-1 (8) for 2 points, Hard.",
			"tags": [
				"Xenos",
				"Necrons"
			],
			"difficulty": "iq/h",
			"points": 2
		},
		{
			"id": "stNyEmWQJx-tk8OiV",
			"name": "Heraldry",
			"local_notes": "Lore: Lychguard know the ritual forms, ranks and grudges of the nobility they guard.\n\nDesign: IQ+0 (9) for 1 point, Average.",
