							"amount": -4
						}
					]
				},
				{
					"id": "tjK-0LgTnncMursfI",
					"name": "Increased Basic Move (Flayed One)",
					"local_notes": "Lore: Flayed Ones do not march in rank; they scuttle, bound and leap across broken ground to reach prey, a hunter's gait rather than a Warrior's inexorable walk.\n\nDesign: Increased Basic Move +2 (B17, 5/level, 10 points) for Move 8 (Basic Speed 6.5 gives Move 6 before this purchase).",
					"tags": [
						"Advantage",
						"Physical",
						"Xenos",
						"Necrons"
					],
					"base_points": 10,
					"features": [
						{
							"type": "attribute_bonus",
							"attribute": "basic_move",
							"amount": 2
						}
