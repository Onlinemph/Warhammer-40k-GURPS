					"sv": 1,
					"damage": {
						"type": "pi+",
						"base": "10d"
					},
					"accuracy": "2",
					"range": "180/550",
					"rate_of_fire": "10",
					"shots": "24(4)",
					"bulk": "-5",
					"recoil": "4",
					"strength": "15",
					"usage": "Dakka (full auto)",
					"usage_notes": "Malf 15 (see design). Every snazzgun is individually built and often carries an idiosyncratic extra effect (a muzzle flare that briefly blinds, a second hidden barrel, a built-in gitfinda) left to the GM to add for a specific named weapon rather than statted generically here.",
