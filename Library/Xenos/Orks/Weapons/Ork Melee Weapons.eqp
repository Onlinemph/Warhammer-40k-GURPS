					"damage": {
						"type": "cr",
						"st": "thr",
						"base": "8d",
						"armor_divisor": 10
					},
					"reach": "C",
					"parry": "-2",
					"strength": "22",
					"usage": "Punch/crush",
					"usage_notes": "Cannot be used to Feint, as the Imperium power fist it's built from. The field is a genuine disruption field (built, per Ork fashion, by copying or looting the principle rather than understanding it) and shares the project's power-field Armor Divisor (10).",
					"defaults": [
