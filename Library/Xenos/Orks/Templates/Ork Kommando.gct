		{
			"id": "s4w7c3kYh01CrfEGw",
			"name": "Tracking",
			"local_notes": "Lore: Following an enemy patrol back to a position worth ambushing.\n\nDesign: Per+0 (8) for 2 points, Average.",
			"tags": [
				"Xenos",
				"Orks"
			],
			"difficulty": "per/a",
			"points": 2
		},
		{
			"id": "sMjLYGsl1tOGt2jnS",
			"name": "Explosives",
			"local_notes": "Lore: A Kommando is often the mob's own sapper, rigging charges under an enemy's nose.\n\nDesign: IQ+0 (8) for 2 points, Average.",
