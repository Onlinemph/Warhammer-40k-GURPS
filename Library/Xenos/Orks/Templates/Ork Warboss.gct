							},
							"amount": 1,
							"specialization": {
								"compare": "is",
								"qualifier": "Ork Spacecraft"
							}
						}
					]
				},
				{
					"id": "tWZReVOCWsF5lxyrH",
					"name": "Mercenary Streak",
					"local_notes": "Lore: A Freebooter always wants a bigger cut of the loot.\n\nDesign: Quirk (B9), roleplaying flag only.",
					"tags": [
						"Quirk",
						"Xenos",
						"Orks"
					],
					"base_points": -1
				}
