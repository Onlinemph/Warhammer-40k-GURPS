			"children": [
				{
					"id": "t-jGKnJXYe-Ng0_jk",
					"name": "Squig-Rider",
					"local_notes": "Lore: A Snakebite grows up on squig-back.\n\nDesign: Perk (B9), +1 to Riding (Squig).",
