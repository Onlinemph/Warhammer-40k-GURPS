		{
			"id": "Td9DxX_Unvc1cUMf4",
			"name": "Klan: Deathskulls",
			"local_notes": "Lore: Deathskulls are the Ork underworld's finest looters and the best Mekaniaks at making stolen tech work, on the principle that if you find it first, it's yours.\n\nDesign: Net 0 points, per-Klan flavour lens.",
			"tags": [
				"Xenos",
				"Orks"
			],
			"children": [
				{
					"id": "tVpkoEOnzYn76lw-H",
					"name": "Looter's Eye",
					"local_notes": "Lore: A Deathskull can spot the one usable part in a scrapheap at a glance.\n\nDesign: Perk (B9), +1 to Scrounging.",
					"tags": [
						"Perk",
						"Xenos",
						"Orks"
					],
					"base_points": 1,
