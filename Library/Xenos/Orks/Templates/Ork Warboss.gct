				{
					"id": "tZPN_rZ-nKqVpXWC6",
					"name": "Zoggin' Tech",
					"local_notes": "Lore: A Snakebite trusts a good squig over a Mek's contraption every time.\n\nDesign: Quirk (B9), roleplaying flag only.",
					"tags": [
						"Quirk",
						"Xenos",
						"Orks"
					],
					"base_points": -1
				},
				{
					"id": "toaLBVmX0hEJj1kZp",
					"name": "Superstitious",
					"local_notes": "Lore: Snakebites hold to old tribal taboos and lucky charms far more than other Klans.\n\nDesign: Quirk (B9), roleplaying flag only.",
					"tags": [
						"Quirk",
						"Xenos",
						"Orks"
