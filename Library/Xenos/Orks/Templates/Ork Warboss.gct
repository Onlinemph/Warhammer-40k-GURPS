	"skills": [
		{
			"id": "sm5N_44gDOf23Awew",
			"name": "Brawling",
			"local_notes": "Lore: A Warboss's signature weapon is often a power klaw, and a klaw is a fist, so it is swung with Brawling (as the Power Klaw entry uses); decades of winning every fight, armed or not.\n\nDesign: DX+7 (19) for 24 points, Easy. Replaces a separate Two-Handed Axe/Mace (Power Klaw) and a 4-point Brawling: the Power Klaw weapon line uses Brawling, so the points now buy the skill the klaw actually uses.",
			"tags": [
				"Xenos",
				"Orks"
			],
			"difficulty": "dx/e",
			"points": 24
		},
		{
			"id": "sDHB18EnfHx5_oCmu",
			"name": "Guns",
			"local_notes": "Lore: Even a Warboss carries a shoota or bigger for when the klaw isn't enough reach.\n\nDesign: DX+4 (16) for 12 points, Easy.",
			"tags": [
				"Xenos",
