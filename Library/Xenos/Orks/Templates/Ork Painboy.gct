		},
		{
			"id": "sgWT_KQCvnGoqeDHq",
			"name": "Diagnosis",
			"local_notes": "Lore: Working out what's actually wrong with a patient before reaching for the saw — usually.\n\nDesign: IQ-1 (7) for 2 points, Hard; +2 more in practice from Painboy's Eye 2.",
			"tags": [
				"Xenos",
				"Orks"
			],
			"difficulty": "iq/h",
			"points": 2
		},
		{
			"id": "s3Mvl-GLiOTL5hCIX",
			"name": "Pharmacy",
			"local_notes": "Lore: Mixing Ork \"medicine,\" which is as likely to be a stimulant, a painkiller, or both at once, badly measured.\n\nDesign: IQ-1 (7) for 2 points, Hard.",
			"tags": [
				"Xenos",
				"Orks"
			],
			"specialization": "(Ork Brews)",
			"difficulty": "iq/h",
			"points": 2
		},
		{
			"id": "s-ee49aWDJpDSIISJ",
			"name": "Brawling",
			"local_notes": "Lore: See the Ork Boy template.\n\nDesign: DX+0 (11) for 1 point, Easy.",
			"tags": [
				"Xenos",
				"Orks"
			],
			"difficulty": "dx/e",
			"points": 1
