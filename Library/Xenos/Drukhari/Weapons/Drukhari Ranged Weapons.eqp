							},
							"modifier": -4
						}
					]
				},
				{
					"id": "W0cwNCJQxHaJSrhMP",
					"sv": 1,
					"damage": {
						"type": "cor",
						"base": "2d"
					},
					"range": "5",
					"rate_of_fire": "1",
					"shots": "6(4)",
					"bulk": "-4",
					"strength": "10",
					"usage": "Follow-up (per turn while gel clings, 1d turns)",
					"usage_notes": "Not stopped by DR. Ends when the target spends a turn wiping or washing the gel off, or when it has run for 1d turns. Fully sealed armour holds the gel off for one turn while it eats through the seals: the follow-up starts on the second turn.",
					"defaults": [
