							},
							"amount": 1
						}
					]
				},
				{
					"id": "texAkNZusHCDB4K45",
					"name": "Crowd's Favourite",
					"reference": "B100",
					"local_notes": "Lore: A Wych is an entertainer first; the crowd's roar is its own reward and its own tax.\n\nDesign: Perk (B100), +1 to Performance.",
					"tags": [
						"Perk",
						"Xenos",
						"Drukhari"
					],
					"base_points": 1,
					"features": [
