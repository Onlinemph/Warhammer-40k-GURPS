							"name": "Accessibility",
							"reference": "B110",
							"local_notes": "One dose per combat; effect lasts the fight, then the comedown. ",
							"cost_adj": "-30%"
						}
					],
					"points_per_level": 5,
					"can_level": true,
					"levels": 2,
					"features": [
						{
							"type": "attribute_bonus",
							"attribute": "will",
							"amount": 2
						}
					]
				},
