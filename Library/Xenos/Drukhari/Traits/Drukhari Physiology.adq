					"name": "Blade-Discipline",
					"reference": "B100",
					"local_notes": "Lore: The Cult's drill, repeated on the klaive.\n\nDesign: Perk (B100), +1 to Two-Handed Sword.",
					"tags": [
						"Perk",
						"Xenos",
						"Drukhari"
					],
					"base_points": 1,
					"features": [
						{
							"type": "skill_bonus",
