				{
					"id": "t6z2C0_ClQMJJ3NDk",
					"name": "High Pain Threshold",
					"reference": "B59",
					"local_notes": "Lore: Haemonculi rebuild their own nervous systems; pain is a thing they choose to feel.\n\nDesign: High Pain Threshold (B59, 10 points).",
					"tags": [
						"Advantage",
						"Physical",
						"Xenos",
						"Drukhari"
					],
					"base_points": 10
				},
				{
					"id": "t1ZKj1g0xaqLBYrDA",
					"name": "Hard to Kill",
					"reference": "B58",
					"local_notes": "Lore: A Haemonculus's body is a work of redundancy: organs doubled, vessels rerouted.\n\nDesign: Hard to Kill 2 (B58, 2/level, 4 points).",
