				{
					"id": "tFsJW5etReSkjDpJB",
					"name": "Hard to Kill",
					"reference": "B58",
					"local_notes": "Lore: Duplicated organs and reinforced vessels keep a Wrack up long after he should be down.\n\nDesign: Hard to Kill 3 (B58, 2/level, 6 points).",
					"tags": [
						"Advantage",
