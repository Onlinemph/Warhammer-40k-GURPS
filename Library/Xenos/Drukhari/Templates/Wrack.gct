				{
					"id": "tPSzAgb__jw2q6Irq",
					"name": "Bulked Frame",
					"reference": "B16",
					"local_notes": "Lifting ST +2.\n\nLore: Wracks are hauled, bloated and rebuilt into load-bearing servants.\n\nDesign: Lifting ST 2 (B16, 3/level, 6 points).",
					"tags": [
