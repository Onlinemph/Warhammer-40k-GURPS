				{
					"id": "tCgdCgZLcoSGtr_wz",
					"name": "High Pain Threshold",
					"reference": "B59",
					"local_notes": "Lore: Deadened nerves: a Wrack's screams are the Haemonculus's, not his own.\n\nDesign: High Pain Threshold (B59, 10 points).",
					"tags": [
						"Advantage",
						"Physical",
						"Xenos",
