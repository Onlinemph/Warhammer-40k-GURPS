		{
			"id": "TUjseZp41mnDz5pMr",
			"name": "Archon's Estate",
			"local_notes": "Lore: Money and rank in Commorragh: an Archon has more of both than nearly anyone. Background.\n\nDesign: 30 + 20 = 50 points.",
			"tags": [
				"Advantage",
