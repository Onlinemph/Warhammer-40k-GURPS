										"compare": "is",
										"qualifier": "Two-Handed Axe/Mace"
									},
									"modifier": -3
								}
							]
						}
					],
					"quantity": 1,
					"equipped": true
				},
				{
					"id": "eW96ljYMQ9Pl9Z1Ul",
					"description": "Aquila Icon",
					"local_notes": "A small icon of the Imperial faith worn or carried by most Guardsmen.\n\nLore: Nearly universal across Imperial citizenry, referenced throughout Black Library fiction regardless of a character's actual devoutness.\n\nDesign: Flavour item; no mechanical effect.",
					"base_value": "5",
					"base_weight": "0.25 lb",
					"quantity": 1,
					"equipped": true
				}
			]
		},
		{
			"id": "eORlTmRoDBQB2Xo6L",
			"description": "Chrono",
			"local_notes": "A rugged wrist or pocket chronometer.\n\nLore: Unremarkable but near-universal personal timekeeping across the Imperium, mentioned in passing across Black Library fiction rather than dwelt on.\n\nDesign: No anchor; a plain GURPS wristwatch (Basic Set) equivalent, at a low TL since timekeeping is mechanically trivial regardless of setting.",
			"tags": [
				"Gear",
				"Imperium"
			],
			"tech_level": "8",
			"legality_class": "4",
			"base_value": "40",
			"base_weight": "0.25 lb",
			"quantity": 1
		},
		{
			"id": "eKIzuPKgCuZMuKz9I",
			"description": "Glow-globe / Stablight",
			"local_notes": "Handheld or hung electric light; the glow-globe is a softer, room-lighting sphere, the stablight a focused beam torch.\n\nLore: Standard Imperial lighting, mentioned throughout Black Library fiction wherever characters move through unlit corridors, hab-blocks or underhive tunnels.\n\nDesign: No anchor; a plain GURPS flashlight/lantern (Basic Set) under Imperial naming, at a low TL since it's mechanically simple household/field tech.",
			"tags": [
				"Gear",
				"Imperium"
			],
			"tech_level": "8",
			"legality_class": "4",
			"base_value": "25",
			"base_weight": "1 lb",
			"quantity": 1
		},
		{
			"id": "ecD4jMeCwMKaKklZz",
			"description": "Cameleoline Cloak",
			"local_notes": "A light-bending, pattern-disrupting cloak fabric; the +3 to Stealth above applies while the cloak is worn and the wearer is stationary or moving slowly enough to keep it effective (GM's call on faster movement).\n\nLore: Cameleoline cloaks are the signature camouflage gear of Imperial snipers and scout troops (Catachan and Tanith patterns both appear in Black Library fiction, most notably the Tanith First-and-Only's scouts in the Gaunt's Ghosts series) — a fabric that bends light and breaks up a wearer's outline rather than simple colour-matched cloth.\n\nDesign: No anchor; modelled as a flat +3 to Stealth (the Camouflage skill is for making camouflage, not for benefiting from it), an independently-reasoned value rather than one copied from a catalogue entry, with no DR and TL 10 to match the Imperium's standard manufacture, since the cloak's whole function is concealment rather than protection. Restricted to LC2 to reflect its status as specialist rather than universal-issue kit.",
			"tags": [
				"Gear",
				"Imperium",
				"Astra Militarum"
			],
			"tech_level": "10",
			"legality_class": "2",
			"base_value": "600",
			"base_weight": "3 lb",
			"features": [
				{
					"type": "skill_bonus",
					"selection_type": "skills_with_name",
					"name": {
						"compare": "is",
						"qualifier": "Stealth"
					},
					"amount": 3
				}
			],
			"quantity": 1
		}
	]
}
