			"children": [
				{
					"id": "egy8swLIzyjibiRC4",
					"description": "Auto-senses Suite (Sororitas Pattern)",
					"local_notes": "Basic audio filtering and low-light optics; simpler than the Astartes suite, no auto-cueing threat display.\n\nLore: A modest sensory package, adequate for a human's reaction speed rather than a post-human's.\n\nDesign: Small flat skill bonus in place of the fuller Astartes package below; no anchor, kept deliberately weaker than the Astartes version per the framework's \"lighter than Astartes plate\" note.",
					"base_value": "3000",
					"base_weight": "3 lb",
					"features": [
						{
							"type": "skill_bonus",
							"selection_type": "skills_with_name",
							"name": {
								"compare": "is",
								"qualifier": "Observation"
							},
							"amount": 1
						}
					],
					"quantity": 1,
					"equipped": true
				},
				{
					"id": "etyUlA0BPJgjGitiX",
					"description": "Vox-Link (Integrated)",
					"local_notes": "Short-to-medium range encrypted vox built into the gorget; functions as a Vox-Caster with reduced range (see Imperial Field Gear).\n\nLore: Every Battle Sister fights as part of a squad and chapter of communication discipline; integrated comms are standard across Imperial power armour.\n\nDesign: Flavour/utility subsystem; no DR or attribute effect, priced as a fraction of a standalone vox-caster.",
					"base_value": "1500",
					"base_weight": "2 lb",
					"quantity": 1,
					"equipped": true
				},
				{
					"id": "e99pg0Lsl_5HJ-Q1Q",
					"description": "Respirator & Void Seal",
					"local_notes": "Full atmospheric seal; grants immunity to inhaled toxins and gas while sealed, and short-duration vacuum survival.\n\nLore: Depicted whenever Sisters fight in space hulks, plague zones, or void war, consistent with Astartes-style sealed plate.\n\nDesign: No anchor; standard sealed-armour assumption carried over from the Astartes suit's equivalent subsystem.",
					"base_value": "2000",
					"base_weight": "5 lb",
