					"sv": 1,
					"damage": {
						"type": "cut",
						"st": "sw",
						"base": "3d+1",
						"armor_divisor": 10
					},
					"reach": "1",
					"parry": "0",
					"strength": "16",
					"usage": "Field on",
					"defaults": [
						{
							"type": "dx",
							"modifier": -5
						},
						{
							"type": "skill",
							"name": {
								"compare": "is",
								"qualifier": "Broadsword"
							}
						},
						{
