						"base": "1d"
					},
					"usage": "Concussion",
					"usage_notes": "Everyone within 3 yards who fails a HT-4 roll is stunned (B420) and deafened for 1d rounds, in addition to the blast damage.",
					"defaults": [
						{
							"type": "dx",
							"modifier": -3
