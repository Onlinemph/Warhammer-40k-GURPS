						"type": "pi+",
						"base": "5d+1"
					},
					"accuracy": "4",
					"range": "500/2000",
					"rate_of_fire": "10",
					"shots": "250(20)",
					"bulk": "-6",
					"recoil": "3",
					"strength": "12B",
					"usage": "Standard",
					"defaults": [
