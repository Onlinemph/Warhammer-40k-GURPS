		{
			"id": "eXXfECcrkeRwbzurU",
			"description": "Lascarbine",
			"local_notes": "Lore: A cut-down lasgun issued to vehicle crew, tank riders and scouts who need something more compact than a full-length rifle; short-barrelled lasguns of this kind appear throughout Guard fiction as tank-crew and support-trooper sidearms.\n\nDesign: Damage fixed at the lasgun anchor (5d(2) burn); the lasing chemistry that produces that figure doesn't depend on barrel length the way a slugthrower's velocity does, so the carbine's shorter emitter only costs Acc and effective range (5/200-600 vs. the full lasgun's 6/300-900) while buying a much better Bulk (-2) for cramped vehicle interiors.",
			"tags": [
				"Missile Weapon",
				"Imperium",
				"Astra Militarum"
			],
			"tech_level": "10",
			"legality_class": "3",
			"base_value": "480",
			"base_weight": "6 lb",
			"weapons": [
				{
					"id": "W0J3oZKwNflSZ8s9e",
					"sv": 1,
					"damage": {
