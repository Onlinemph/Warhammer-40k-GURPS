		{
			"id": "emzRaBn2b0xGn7afM",
			"description": "Boltgun, Umbra Pattern",
			"local_notes": "Lore: One of the older mass-produced boltgun patterns, predating Godwyn-De'az manufacture in several Chapter armouries and Forge World background as a heavier, more conservatively built weapon kept in service out of reliability and reverence rather than performance.\n\nDesign: Fires the same standard .75-calibre mass-reactive bolt as every other weapon on this page, so the damage line is identical to the Godwyn-pattern anchor (6dx2(2) pi++, follow-up 6d cr ex); the pattern difference is manufacture and furniture, not ballistics. Modelled as 1 lb heavier than Godwyn with no other stat change, per the framework's rule that lore differences not tied to an anchor stay cosmetic.",
			"tags": [
				"Missile Weapon",
				"Imperium",
				"Adeptus Astartes"
			],
			"tech_level": "10",
			"legality_class": "1",
			"base_value": "1100",
			"base_weight": "15 lb",
			"weapons": [
				{
					"id": "Wfr92z03zGxEd2K8j",
					"sv": 1,
