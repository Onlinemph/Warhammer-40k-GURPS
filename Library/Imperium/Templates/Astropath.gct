				{
					"id": "tdYS3pHuwoK3kVTO_",
					"name": "Mental Interrogation",
					"local_notes": "Lore: Reads surface thoughts, willing or not — an Inquisitorial interrogator's favourite tool.\n\nDesign: Mind Reading, Basic's core advantage, flat 30, with Warp/Perils.",
					"tags": [
						"Advantage",
