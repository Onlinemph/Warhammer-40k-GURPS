						{
							"id": "tmHF1yg9jRsCLXKB9",
							"name": "Duty (Chapter and Imperium)",
							"reference": "B133",
							"local_notes": "Almost all the time, Extremely Hazardous.",
							"base_points": -15
						},
						{
							"id": "tKM1xmHa2mSwenPNa",
							"name": "Sense of Duty (Battle-Brothers)",
							"reference": "B153",
							"base_points": -10
						},
						{
							"id": "t2T5ESMoW38zrYyzc",
							"name": "Code of Honor (Codex Astartes)",
							"reference": "B127",
