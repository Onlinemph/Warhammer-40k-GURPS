		{
			"id": "s_VKS2UiKjoridBDJ",
			"name": "Area Knowledge",
			"local_notes": "Lore: Knowledge of the current campaign's area of operations.\n\nDesign: IQ+0 (12) for 1 point, Easy.",
			"tags": [
				"Imperium"
			],
