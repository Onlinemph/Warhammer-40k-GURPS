			],
			"difficulty": "iq/a",
			"points": 4
		},
		{
			"id": "sskkiT_a-30BeKDie",
			"name": "Law",
			"local_notes": "Lore: A Commissar's summary judgments still draw on the Lex Imperialis' framework, however abbreviated the process.\n\nDesign: IQ+0 (12) for 4 points, Hard.",
			"tags": [
