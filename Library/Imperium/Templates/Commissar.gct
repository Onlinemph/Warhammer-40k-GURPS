		},
		{
			"id": "sCbtWXP_u9aWnVe-O",
			"name": "Current Affairs",
			"local_notes": "Lore: Awareness of Imperium-wide news, expected of an Officio Prefectus officer.\n\nDesign: IQ+0 (12) for 1 point, Easy.",
			"tags": [
				"Imperium"
			],
