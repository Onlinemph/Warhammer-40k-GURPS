		{
			"id": "s3ZyqTEMdZXltV_33",
			"name": "Heraldry",
			"local_notes": "Lore: A Commissar is typically attached to a regiment not their own and must learn its customs quickly.\n\nDesign: IQ+0 (12) for 2 points, Average.",
			"tags": [
				"Imperium",
				"Astra Militarum"
			],
			"specialization": "Regimental",
			"difficulty": "iq/a",
			"points": 2
		},
		{
			"id": "sSEJRfOY6V4cNrT5L",
			"name": "Theology",
			"local_notes": "Lore: A working command of the Imperial Creed, since a Commissar is also a lay authority on Imperial orthodoxy in the field.\n\nDesign: IQ-1 (11) for 2 points, Hard.",
