			"name": "Broadsword",
			"local_notes": "Lore: A Commissar's chainsword or power sword, per framework.md's weapon-skill table.\n\nDesign: DX+3 (15) for 12 points, Average.",
			"tags": [
				"Imperium",
				"Astra Militarum"
			],
