					"name": "Xenos Threat Assessment",
					"local_notes": "Lore: Ordo Xenos work demands real, working xenology, not folklore.\n\nDesign: Perk (B9), +1 to Expert Skill (Xenology).",
					"tags": [
						"Perk",
						"Imperium"
					],
					"base_points": 1,
