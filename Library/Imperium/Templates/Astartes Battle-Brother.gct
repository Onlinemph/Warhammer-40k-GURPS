				},
				{
					"type": "attribute_bonus",
					"attribute": "per",
					"amount": 1
				}
			]
		},
		{
			"id": "t4SqFvjZH4CmMMl-3",
			"name": "Rank 3 (Battle-Brother, Veteran)",
			"reference": "B29",
			"local_notes": "Lore: Recognized standing within the squad and Chapter hierarchy built up over decades: enough seniority to be trusted with a fireteam or combat squad in his Sergeant's absence, short of holding a command role himself.\n\nDesign: Rank (B29), 5 points/level, 3 levels = 15 points.",
			"base_points": 15
		},
		{
			"id": "tzNrWmE4pCOxBIiQ1",
			"name": "Reputation (Angel of Death)",
			"reference": "B27",
			"local_notes": "Lore: An Astartes in his Chapter's heraldry is instantly recognized by Imperial citizens and soldiery, who react with awe, hope, or fear -- a constant, near-universal reaction shown wherever Marines appear in the fiction.\n\nDesign: Small, reliably-recognized reaction bonus (+2), priced as a minor Reputation (B27): 5 points.",
			"base_points": 5,
			"features": [
				{
					"type": "reaction_bonus",
					"situation": "from Imperial citizens and Guard who recognize the Chapter's colors",
					"amount": 2
				}
			]
		}
	],
