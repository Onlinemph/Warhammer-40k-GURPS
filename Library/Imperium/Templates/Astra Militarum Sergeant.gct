					"name": "Catachan Jungle Craft",
					"local_notes": "Lore: A Catachan childhood is basic jungle-survival training.\n\nDesign: Perk (B9), +1 to Survival (Jungle).",
					"tags": [
						"Perk",
						"Imperium"
					],
					"base_points": 1,
