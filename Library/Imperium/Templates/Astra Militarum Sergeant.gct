					"id": "tghxZ8W0EkHP2o6TQ",
					"name": "Siege Discipline",
					"local_notes": "Lore: Krieg doctrine is built around trench warfare, sapping, and siege engineering.\n\nDesign: Perk (B9), +1 to Demolition.",
					"tags": [
						"Perk",
						"Imperium"
					],
