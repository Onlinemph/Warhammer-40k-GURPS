							},
							"amount": 1
						}
					]
				},
				{
					"id": "tw-3QwisNuEo91Vrd",
					"name": "Cadian Pride",
					"local_notes": "Lore: A Cadian will not yield ground and will not admit that Cadia is gone; \"Cadia stands\" is both a boast and a refusal.\n\nDesign: Quirk (B9), roleplaying flag only.",
					"tags": [
						"Quirk",
						"Imperium"
					],
					"base_points": -1
				}
