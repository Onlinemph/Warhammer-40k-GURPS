			"name": "HT",
			"local_notes": "Lore: A Navigator must survive years of continuous warp exposure; House bloodlines select for endurance.\n\nDesign: HT 11 (+1 from baseline), 10 pts/level (B15).",
			"tags": [
				"Attribute"
			],
			"base_points": 10,
