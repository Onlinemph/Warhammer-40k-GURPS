			],
			"base_points": 0
		},
		{
			"id": "tPKWA04w5KaHnLaaI",
			"name": "IQ",
			"local_notes": "Lore: Centuries of selective breeding for the strength and control the third eye demands also selects for sharp, disciplined minds.\n\nDesign: IQ 12 (+2 from baseline), 20 pts/level (B15).",
			"tags": [
