				}
			]
		},
		{
			"id": "tTBoEPeUKBxxcBaL9",
			"name": "Will",
			"local_notes": "Lore: The will needed to hold a ship's course through the immaterium without being lost or consumed by it.\n\nDesign: Will+4 (Basic's Increased Will, 5 pts/level, B15).",
			"tags": [
				"Attribute"
