	"skills": [
		{
			"id": "sw38Vts20SgZAaMa8",
			"name": "Psyniscience",
			"local_notes": "Lore: The trained (or instinctive) sense of \"something wrong\" in a presence, place, or object touched by the warp — a chill in a corridor, a servitor's dead eyes going wrong. Named for the Dark Heresy/Only War skill of the same purpose (Psyniscience), used here for calibration only; the GURPS build is original.\n\nDesign: New skill per framework.md (\"New skills only when nothing fits\"). Per/H with no default: nobody can roll it untrained. Characters with a Psyker Talent (see the psyker power library, not part of this file) get it at a discount per that trait's rules. An unaugmented human without any psychic Talent has nothing latent to sense with and must buy it as an unusual background purchase, if a GM allows it at all; most unaugmented Imperial citizens simply never take this skill.",
			"tags": [
				"Mental",
				"Imperium",
				"Psionic"
			],
			"difficulty": "per/h",
			"points": 4
		},
		{
			"id": "sbTELMr53VJfDfWPt",
			"name": "Meditation",
			"local_notes": "Lore: How a psyker learns to control, rather than merely survive, the gift.\n\nDesign: Meditation is Will/Hard (B207). Will 14, 2 points = Will-1 (13).",
			"tags": [
				"Imperium",
				"Psyker"
			],
			"difficulty": "will/h",
			"points": 2
		},
		{
			"id": "snvBKZC4EJMAYzmsY",
			"name": "Hidden Lore",
			"local_notes": "Lore: Doctrinal and practical knowledge of the immaterium taught at the Scholastia Psykana.\n\nDesign: IQ-1 (11) for 2 points, Average.",
			"tags": [
				"Imperium",
				"Psyker"
			],
			"specialization": "the Warp",
			"difficulty": "iq/a",
			"points": 2
		},
		{
			"id": "sJBFdc-wpHuKk09_s",
			"name": "Soldier",
			"local_notes": "Lore: Enough general military knowledge to operate attached to a Guard unit.\n\nDesign: IQ-1 (11) for 2 points, Average.",
			"tags": [
				"Imperium",
				"Astra Militarum"
			],
			"difficulty": "iq/a",
			"points": 2
		},
		{
			"id": "sa6GwsyuVZ_vBwK57",
			"name": "Theology",
			"local_notes": "Lore: The same basic catechisms drilled into every Imperial soldier, doubly important for a psyker who must prove their faith.\n\nDesign: IQ-2 (10) for 1 point, Hard.",
			"tags": [
				"Imperium"
			],
			"specialization": "Imperial Creed",
			"difficulty": "iq/h",
			"points": 1
		},
		{
			"id": "sckzvxXyv0xQbEKWy",
			"name": "Staff",
