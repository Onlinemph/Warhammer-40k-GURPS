	"skills": [
		{
			"id": "sw38Vts20SgZAaMa8",
			"name": "Psyniscience",
			"local_notes": "Lore: The trained (or instinctive) sense of \"something wrong\" in a presence, place, or object touched by the warp — a chill in a corridor, a servitor's dead eyes going wrong. Named for the Dark Heresy/Only War skill of the same purpose (Psyniscience), used here for calibration only; the GURPS build is original.\n\nDesign: New skill per framework.md (\"New skills only when nothing fits\"). Per/H, Talent-affected: characters with a Psyker Talent (see the psyker power library — not part of this file) get it at a discount per that trait's rules and may default it from Per at a penalty; an unaugmented human without any psychic Talent cannot default into it at all (there is nothing latent to sense with) and must buy it as an unusual background purchase, if a GM allows it at all — most unaugmented Imperial citizens simply never take this skill.",
			"tags": [
				"Mental",
				"Imperium",
				"Psionic"
			],
			"difficulty": "per/h",
			"points": 4
		},
		{
			"id": "sbTELMr53VJfDfWPt",
			"name": "Meditation",
			"local_notes": "Lore: How a psyker learns to control, rather than merely survive, the gift.\n\nDesign: IQ-2 (10) for 2 points, Hard (B ability skill list).",
			"tags": [
				"Imperium",
				"Psyker"
			],
			"difficulty": "iq/h",
			"points": 2
		},
		{
			"id": "snvBKZC4EJMAYzmsY",
			"name": "Hidden Lore",
			"local_notes": "Lore: Doctrinal and practical knowledge of the immaterium taught at the Scholastia Psykana.\n\nDesign: IQ-1 (11) for 2 points, Average.",
			"tags": [
				"Imperium",
				"Psyker"
			],
			"specialization": "the Warp",
			"difficulty": "iq/a",
			"points": 2
		},
		{
			"id": "sJBFdc-wpHuKk09_s",
			"name": "Soldier",
			"local_notes": "Lore: Enough general military knowledge to operate attached to a Guard unit.\n\nDesign: IQ-1 (11) for 2 points, Average.",
			"tags": [
				"Imperium",
				"Astra Militarum"
			],
			"difficulty": "iq/a",
			"points": 2
		},
		{
			"id": "sa6GwsyuVZ_vBwK57",
			"name": "Theology",
			"local_notes": "Lore: The same basic catechisms drilled into every Imperial soldier, doubly important for a psyker who must prove their faith.\n\nDesign: IQ-2 (10) for 1 point, Hard.",
			"tags": [
				"Imperium"
			],
			"specialization": "Imperial Creed",
			"difficulty": "iq/h",
			"points": 1
		},
		{
			"id": "sckzvxXyv0xQbEKWy",
			"name": "Staff",
			"local_notes": "Lore: Basic proficiency with the issued force staff.\n\nDesign: DX+0 (11) for 4 points, Average.",
			"tags": [
				"Imperium",
				"Psyker"
			],
			"difficulty": "dx/a",
			"points": 4
		}
	],
	"equipment": [
		{
			"id": "ejMJP2wi8GH75XMVG",
			"description": "Force Staff",
			"local_notes": "Lore: Many psykers prefer a staff to a blade: easier to carry openly as a badge of office, and a familiar focus for channelling telekinetic and biomantic workings. Common across Dark Heresy/Rogue Trader's force-weapon options and depicted for Inquisitorial and Adeptus Astra Telepathica psykers throughout Black Library.\n\nDesign: Same power-field math as the Force Sword (field on adds +1d and armour divisor (10) over the field-off mundane baseline), applied to a plain hardwood-and-metal quarterstaff (sw+1 cr) instead of an edged blade — a crushing rather than cutting power weapon, with the same charged Force Strike option and scaling note.",
			"tags": [
				"Melee Weapon",
				"Imperium",
				"Psyker"
			],
