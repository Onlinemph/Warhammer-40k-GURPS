							"name": "Perils of the Warp",
							"cost_adj": "-10%"
						}
					],
					"points_per_level": 4,
					"can_level": true,
					"levels": 1
				},
				{
					"id": "tK8NsrSDvGepTHyLV",
					"name": "Endurance",
					"local_notes": "Lore: Wards off fatigue and pain in battle by forcing the body past its limits.\n\nDesign: Extra Fatigue Points (3/level, B ~power-ups table) with Warp/Perils.",
					"tags": [
						"Advantage",
						"Mental",
						"Psyker",
						"Imperium"
					],
					"modifiers": [
						{
							"id": "mp60UxUd1VzBXcFH2",
							"name": "Warp",
							"cost_adj": "-15%"
						},
						{
							"id": "mzbYjPSyTYaWxEUvp",
							"name": "Perils of the Warp",
							"cost_adj": "-10%"
						}
					],
					"points_per_level": 3,
					"can_level": true,
					"levels": 1
				},
				{
					"id": "tAbovak_anx3Z3KkF",
					"name": "Warp Speed",
					"local_notes": "Lore: Quickens the caster's own nervous system and reflexes to a blur.\n\nDesign: Increased Basic Speed (5 points per +0.25, B) with Warp/Perils; the resulting Dodge increase comes free from Basic's normal Speed-to- Dodge derivation, no separate purchase needed.",
					"tags": [
						"Advantage",
						"Physical",
						"Psyker",
						"Imperium"
					],
					"modifiers": [
						{
							"id": "mRgdK36rt_EUu5VNo",
							"name": "Warp",
							"cost_adj": "-15%"
						},
						{
							"id": "m-m4NjzWMaDNyhZrH",
							"name": "Perils of the Warp",
							"cost_adj": "-10%"
						}
					],
					"points_per_level": 5,
					"can_level": true,
					"levels": 1
				},
				{
					"id": "tm0uVDKTz6dRqBxHg",
					"name": "Iron Arm",
					"local_notes": "Lore: Hardens flesh and bone into something closer to ceramite for a few seconds.\n\nDesign: Damage Resistance (5/level, B) with Warp/Perils.",
					"tags": [
						"Advantage",
						"Physical",
						"Psyker",
						"Imperium"
					],
					"modifiers": [
						{
							"id": "mK3Us2HzrzwIPhFh2",
							"name": "Warp",
							"cost_adj": "-15%"
