		{
			"id": "TcqEJfjn_JPIivPpn",
			"name": "Librarius",
			"local_notes": "Lore: The general Chapter Librarius discipline used across most non-Grey- Knights Space Marine chapters, drawn from Codex: Space Marines background and its recurring Black Library depictions of Librarians in the Horus Heresy and modern-day novels alike.\n\nDesign: Talent-linked group; see each child.",
			"tags": [
				"Advantage",
				"Mental",
				"Psyker",
				"Imperium",
				"Adeptus Astartes"
			],
			"children": [
				{
					"id": "t_2F1f-9o7NLq2TjD",
					"name": "Null Zone",
					"local_notes": "Lore: Strips the warp's protection from everything nearby — invulnerable saves falter, toughened hides thin.\n\nDesign: Affliction (10/level) delivering a Vulnerability-style disadvantage valued (by this project, not a cited RAW table entry) at roughly -20 points, +100% Malediction, +50% Area Effect, then Warp Sorcery and Severe Perils, net +130% — the setting's single most dangerous debuff, priced to match. Full modified cost: 10 x 2.3 = 23 points/level; needs Warp Empowerment level 2 (cap 30).",
					"tags": [
						"Advantage",
						"Mental",
						"Psyker",
						"Imperium"
					],
					"modifiers": [
						{
							"id": "m1dDu1z4AhhBPzyRY",
							"name": "Disadvantage Delivered (Vulnerability",
							"cost_adj": "+20%"
						},
						{
