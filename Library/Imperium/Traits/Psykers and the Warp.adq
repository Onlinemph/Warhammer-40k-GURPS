							"id": "mcrzSDuZ5e10GCmEp",
							"name": "Perils of the Warp",
							"cost_adj": "-10%"
						}
					],
					"base_points": 25
				},
				{
					"id": "tcGzs6xYtyCdaEne6",
					"name": "Forewarning",
					"local_notes": "Lore: An unbidden sense that danger is close, before it strikes.\n\nDesign: Danger Sense, Basic's core advantage, flat 15, with Warp/Perils.",
					"tags": [
						"Advantage",
						"Mental",
						"Psyker",
						"Imperium"
					],
					"modifiers": [
