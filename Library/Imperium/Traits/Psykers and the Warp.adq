						{
							"id": "mz8Zd-olzXVf8VMck",
							"name": "Perils of the Warp",
							"cost_adj": "-10%"
						}
					],
					"points_per_level": 5,
					"can_level": true,
					"levels": 1
				},
				{
					"id": "tCgzc2qW00vhZpl3T",
					"name": "Haemorrhage",
					"local_notes": "Lore: Ruptures blood vessels inside a target from a distance, with no visible attack to dodge.\n\nDesign: Affliction (10/level, B35) delivering a -20 point bleeding/nauseated disadvantage (+20%), Malediction (+100%, B36, resisted by HT instead of dodged), plus Warp/Perils.",
					"tags": [
						"Advantage",
						"Mental",
						"Psyker",
						"Imperium"
					],
					"modifiers": [
						{
							"id": "mCNIwa83UY8Az7Ke7",
