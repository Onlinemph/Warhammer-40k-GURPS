					"points_per_level": 5,
					"can_level": true,
					"levels": 1
				},
				{
					"id": "tEgdysAWIOP3t2fe0",
					"name": "Gate of Infinity",
					"local_notes": "Lore: Tears a hole between two points in real space and steps through — the rarest and most feared telekinetic feat, since a botched Gate can open into the warp itself instead.\n\nDesign: Built on Basic's own Warp advantage (B99, instant travel to any place you have seen/visualized, flat 100), with Preparation Required (-20%, B113, a few seconds' concentration) and the Severe Perils tier, reflecting the setting's specific fear of a failed Gate opening into the immaterium.",
					"tags": [
						"Advantage",
						"Mental",
						"Psyker",
						"Imperium"
					],
					"modifiers": [
						{
							"id": "md6jyfQF3hboLjZmt",
							"name": "Preparation Required",
							"cost_adj": "-20%"
						},
						{
							"id": "mJN059rqyylyCcPx8",
							"name": "Warp",
							"cost_adj": "-15%"
						},
						{
							"id": "mYSnkSW2x2eZsHjdl",
							"name": "Perils of the Warp (Severe)",
							"cost_adj": "-20%"
						}
					],
					"base_points": 100
				}
			]
		},
		{
			"id": "T8kCjTOyeAKu7GQSw",
			"name": "Telepathy",
			"local_notes": "Lore: Reading, sending, and overwhelming minds. Calibrated against Dark Heresy's Telepathy list (Mind Probe, Dominate, Psychic Scream, Terrify, Invisibility-adjacent Mental Interrogation) and the astropathic relay seen throughout Black Library whenever a ship needs to send word home.\n\nDesign: Talent-linked group; see each child.",
			"tags": [
				"Advantage",
				"Mental",
				"Psyker",
				"Imperium"
			],
			"children": [
				{
					"id": "Tdomw2vBoXhmijqkk",
					"name": "Mind Probe/Dominate",
					"local_notes": "Lore: The same intrusion into another mind, bought at two intensities: a forced reading of buried memory, or outright control of the body.\n\nDesign: Alternative_abilities container; full price for the costlier Dominate plus a fifth of Mind Probe.",
					"tags": [
						"Advantage",
						"Mental",
						"Psyker",
						"Imperium"
					],
					"container_type": "alternative_abilities",
					"children": [
						{
							"id": "tSuAfr3NbeG3VsCWN",
							"name": "Mind Probe",
							"local_notes": "Lore: Tears buried memories and secrets from an unwilling subject.\n\nDesign: Mind Probe, Basic's core advantage, flat 20, with Warp/Perils.",
							"tags": [
								"Advantage",
								"Mental",
								"Psyker",
								"Imperium"
							],
							"modifiers": [
