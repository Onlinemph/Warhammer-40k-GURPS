							"cost_adj": "+50%"
						},
						{
							"id": "m7VS7MEYHSSA4BUXT",
							"name": "Warp Sorcery",
							"cost_adj": "-20%"
						},
						{
							"id": "mzPcnTndbnrLEAGdn",
							"name": "Perils of the Warp",
							"cost_adj": "-10%"
						}
					],
					"points_per_level": 10,
					"can_level": true,
					"levels": 1
				},
				{
					"id": "tv3LNiUuH-Jqij-4j",
					"name": "Terrify",
					"local_notes": "Lore: Projects raw, focused fear straight into a target's mind.\n\nDesign: Terror, Basic's core advantage (flat 30 + 10/level for extra range), with Warp Sorcery/Perils, net -30%. Full modified cost: (30+10) x 0.7 = 28 points at its default first extra-range level; needs Warp Empowerment level 2 (cap 30).",
					"tags": [
						"Advantage",
						"Mental",
						"Psyker",
						"Imperium"
					],
					"modifiers": [
						{
							"id": "mZXEXtL-xRTbH3HIS",
							"name": "Warp Sorcery",
							"cost_adj": "-20%"
						},
						{
							"id": "m7zNM7Q8o28_sInEJ",
							"name": "Perils of the Warp",
							"cost_adj": "-10%"
						}
					],
					"points_per_level": 10,
					"can_level": true,
					"levels": 1,
					"base_points": 30
				},
				{
					"id": "tvNkYu_RZR6P9aRdU",
					"name": "Mental Interrogation",
					"local_notes": "Lore: Reads surface thoughts, willing or not — an Inquisitorial interrogator's favourite tool.\n\nDesign: Mind Reading, Basic's core advantage, flat 30, with Warp Sorcery/ Perils, net -30%. Full modified cost: 30 x 0.7 = 21 points; needs Warp Empowerment level 2 (cap 30).",
					"tags": [
						"Advantage",
						"Mental",
						"Psyker",
						"Imperium"
					],
					"modifiers": [
						{
							"id": "mSuQlQgeuXoTzzKl1",
							"name": "Warp Sorcery",
							"cost_adj": "-20%"
						},
						{
							"id": "mvtS17w_GDx71VAVd",
							"name": "Perils of the Warp",
							"cost_adj": "-10%"
						}
					],
					"base_points": 30
				},
				{
					"id": "t7YzSii1R7Srh4kEt",
					"name": "Astrotelepathy",
					"local_notes": "Lore: The astropath's signature act: sending and receiving thought across interstellar distances, relayed choir to choir and, ultimately, through the Astronomican itself. Astropaths who fail badly during a transmission are a recurring Black Library beat (burned out, driven mad, or lost with the ship's Geller field).\n\nDesign: Base 20 points for a mental send-and-receive package is this project's own baseline (Basic's exact per-range-step Telecommunication costs are not confidently recalled, so this figure is fixed for internal consistency rather than cited to a page); Increased Range at the highest tabled step (+60%) for interstellar reach, Preparation Required (-20%, a ritual trance), and the Severe Perils tier for the real danger of transmitting through the warp. Net +60-20-20-20=0%. Full modified cost: 20 x 1.0 = 20 points; needs only Warp Empowerment level 1 (cap 20) — cheap in raw points despite the interstellar range, since Increased Range's +60% roughly cancels the Preparation Required/Warp Sorcery/Severe Perils discounts; the real cost of Astrotelepathy is the Severe Perils roll, not the point price.",
					"tags": [
						"Advantage",
						"Mental",
						"Psyker",
						"Imperium"
					],
					"modifiers": [
						{
							"id": "mh7MZC4zbVHaQRodJ",
							"name": "Increased Range x100",
							"cost_adj": "+60%"
						},
						{
							"id": "mO8i8E9bNb9IQDp6k",
							"name": "Preparation Required",
							"cost_adj": "-20%"
						},
						{
							"id": "msYuYxXZRxoJFsBnQ",
							"name": "Warp Sorcery",
							"cost_adj": "-20%"
						},
						{
							"id": "mQ4ci91kuyJt0z87L",
							"name": "Perils of the Warp (Severe)",
							"cost_adj": "-20%"
						}
					],
					"base_points": 20
				}
			]
		},
		{
			"id": "TbvFBsSDrV3V2Io9y",
			"name": "Sanctic Daemonology",
			"local_notes": "Lore: The Grey Knights' own discipline: powers built and sanctified specifically to fight the warp's own creatures, drawn from Codex: Grey Knights background and its Black Library tie-ins (Ben Counter's Grey Knights novels).\n\nDesign: Talent-linked group, Grey Knights only; see each child.",
			"tags": [
				"Advantage",
				"Mental",
				"Psyker",
				"Imperium",
				"Adeptus Astartes",
				"Grey Knights"
			],
			"children": [
				{
					"id": "t43_vlUo3GY7HEDnf",
					"name": "Banishment",
					"local_notes": "Lore: A bolt of purifying anti-warp force that tears a daemon's physical anchor apart.\n\nDesign: Innate Attack (Impaling, 8/die, B61) restricted to warp-touched targets (Accessibility -10%, kept small since daemons are this unit's routine enemy, not a rare case) plus Warp Sorcery and the Severe Perils tier, net -50%. Full modified cost: 8 x 0.5 = 4 points/level; needs Warp Empowerment level 1 (cap 20).",
					"tags": [
						"Advantage",
						"Mental",
						"Psyker",
						"Imperium",
						"Grey Knights"
					],
					"modifiers": [
						{
							"id": "m4oxNolnxi-CBXs-Z",
							"name": "Accessibility (only vs. Warp-touched/daemonic creatures)",
							"cost_adj": "-10%"
						},
						{
							"id": "m5H-tDI3QxRI_4CNb",
							"name": "Warp Sorcery",
							"cost_adj": "-20%"
						},
						{
							"id": "m0pwpCwSov5G7Krxd",
							"name": "Perils of the Warp (Severe)",
							"cost_adj": "-20%"
						}
					],
					"points_per_level": 8,
					"can_level": true,
					"levels": 1
				},
				{
					"id": "tP4Ehr8z_1J3Lfk0r",
					"name": "Hammerhand",
					"local_notes": "Lore: Channels psychic force into a Grey Knight's blow, letting even blunt strikes crack a daemon's hide.\n\nDesign: Striking ST (5/level, B) with Warp Sorcery/Perils, net -30%. Full modified cost: 5 x 0.7 = ~4 points/level; needs Warp Empowerment level 1 (cap 20).",
					"tags": [
						"Advantage",
						"Physical",
						"Psyker",
						"Imperium",
						"Grey Knights"
					],
					"modifiers": [
						{
							"id": "m-ac2tHUKMc30l81G",
							"name": "Warp Sorcery",
							"cost_adj": "-20%"
						},
						{
							"id": "m_7xvl0ReFpS_RITH",
							"name": "Perils of the Warp",
							"cost_adj": "-10%"
						}
					],
					"points_per_level": 5,
					"can_level": true,
					"levels": 1
				},
				{
					"id": "tbHAy_Yrod0aw1rWw",
					"name": "Sanctuary",
					"local_notes": "Lore: Wards a Grey Knight kill-team against fear, corruption, and possession during a purge.\n\nDesign: Affliction (10, delivering a +15-point protective advantage to willing allies rather than a disadvantage to a foe — Basic B35 allows either) with Area Effect (+50%), Warp Sorcery, and Severe Perils, net +25%. Full modified cost: 10 x 1.25 = ~13 points; needs Warp Empowerment level 1 (cap 20).",
