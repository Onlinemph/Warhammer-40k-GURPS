							"cost_adj": "-20%"
						}
					],
					"points_per_level": 10,
					"can_level": true,
					"levels": 1
				},
				{
					"id": "Tg955hLBL7P-rANtf",
					"name": "Might of Heroes",
					"local_notes": "Lore: A Librarian's traditional pre-charge blessing, filling a squad with unnatural strength and courage.\n\nDesign: Grouped Basic advantages, each carrying Area Effect (squad-wide) plus Warp Sorcery/Perils; GCS sums the children.",
					"tags": [
