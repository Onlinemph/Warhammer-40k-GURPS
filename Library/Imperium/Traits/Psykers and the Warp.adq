					"base_points": 30
				},
				{
					"id": "t7YzSii1R7Srh4kEt",
					"name": "Astrotelepathy",
					"local_notes": "Lore: The astropath's signature act: sending and receiving thought across interstellar distances, relayed choir to choir and, ultimately, through the Astronomican itself. Astropaths who fail badly during a transmission are a recurring Black Library beat (burned out, driven mad, or lost with the ship's Geller field).\n\nDesign: Base 20 points for a mental send-and-receive package is this project's own baseline (Basic's exact per-range-step Telecommunication costs are not confidently recalled, so this figure is fixed for internal consistency rather than cited to a page); Increased Range at the highest tabled step (+60%) for interstellar reach, Preparation Required (-20%, a ritual trance), and the Severe Perils tier for the real danger of transmitting through the warp.",
					"tags": [
						"Advantage",
						"Mental",
						"Psyker",
						"Imperium"
					],
					"modifiers": [
						{
							"id": "mh7MZC4zbVHaQRodJ",
							"name": "Increased Range x100",
							"cost_adj": "+60%"
						},
						{
							"id": "mO8i8E9bNb9IQDp6k",
							"name": "Preparation Required",
							"cost_adj": "-20%"
						},
						{
							"id": "mTWtLz8YtxY4xmHNy",
							"name": "Warp",
							"cost_adj": "-15%"
						},
						{
							"id": "mQ4ci91kuyJt0z87L",
							"name": "Perils of the Warp (Severe)",
							"cost_adj": "-20%"
						}
					],
					"base_points": 20
				}
			]
		},
		{
			"id": "TbvFBsSDrV3V2Io9y",
			"name": "Sanctic Daemonology",
			"local_notes": "Lore: The Grey Knights' own discipline: powers built and sanctified specifically to fight the warp's own creatures, drawn from Codex: Grey Knights background and its Black Library tie-ins (Ben Counter's Grey Knights novels).\n\nDesign: Talent-linked group, Grey Knights only; see each child.",
			"tags": [
				"Advantage",
