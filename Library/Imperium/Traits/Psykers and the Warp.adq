					],
					"base_points": 15
				},
				{
					"id": "tB-YFF1YLY9gNNV8Z",
					"name": "Misfortune",
					"local_notes": "Lore: Turns an enemy's own luck against them — the misfire, the missed step, the wrong turn.\n\nDesign: Affliction (10/level) delivering Unluckiness (-10 points, +10%, matching Basic's own Unluckiness cost), Malediction (+100%), Warp/Perils.",
					"tags": [
						"Advantage",
						"Mental",
						"Psyker",
						"Imperium"
					],
					"modifiers": [
						{
							"id": "mVzlai3Hn2PmQz9gh",
							"name": "Disadvantage Delivered (Unluckiness",
							"cost_adj": "+10%"
						},
						{
							"id": "mLqE5n73coCLl_oDg",
							"name": "Malediction 1",
							"cost_adj": "+100%"
						},
						{
							"id": "mJHYsPXlp8TNy8fFX",
							"name": "Warp",
							"cost_adj": "-15%"
						},
						{
							"id": "mN-XHZhYEG7fJGQO-",
							"name": "Perils of the Warp",
							"cost_adj": "-10%"
						}
					],
					"points_per_level": 10,
					"can_level": true,
					"levels": 1
				},
				{
					"id": "tIpbm5ni7LbhHI0vP",
					"name": "Scrier's Gaze",
					"local_notes": "Lore: Projects the caster's sight to a distant or hidden place.\n\nDesign: Clairsentience, Basic's core advantage, flat 50, with Warp/Perils.",
					"tags": [
						"Advantage",
						"Mental",
						"Psyker",
						"Imperium"
					],
					"modifiers": [
						{
							"id": "mhX9Ot1iQnKDhfAmj",
							"name": "Warp",
