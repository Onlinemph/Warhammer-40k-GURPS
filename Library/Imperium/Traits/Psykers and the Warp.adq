							"cost_adj": "+20%"
						},
						{
							"id": "mL1I1SX3gCFZJUT6k",
							"name": "Malediction 1",
							"cost_adj": "+100%"
						},
						{
							"id": "mFalGiFdF7m79pKHi",
							"name": "Warp",
							"cost_adj": "-15%"
						},
						{
							"id": "mZArMTFlLvT6o8ITL",
							"name": "Perils of the Warp",
							"cost_adj": "-10%"
						}
					],
					"points_per_level": 10,
					"can_level": true,
					"levels": 1
				}
			]
		},
		{
			"id": "TAKHtSp5HYhM6fLU2",
			"name": "Divination",
			"local_notes": "Lore: Sight beyond the present moment: warnings, glimpses of the future, remote viewing, and turning fortune against an enemy. Calibrated against Dark Heresy's Divination list (Foreboding, Machinate, Fate's Hand, Scrier's Gaze all map closely) and Black Library's recurring \"the Emperor's seers dream of what is to come\" beats.\n\nDesign: Talent-linked group; see each child.",
			"tags": [
				"Advantage",
				"Mental",
				"Psyker",
				"Imperium"
			],
			"children": [
				{
					"id": "t-6wrR80ZLwvorBbs",
					"name": "Foresight",
					"local_notes": "Lore: A flash of true precognition — a moment's warning of what is about to happen.\n\nDesign: Precognition, Basic's core advantage, flat 25, with Warp/Perils.",
					"tags": [
						"Advantage",
						"Mental",
						"Psyker",
						"Imperium"
					],
					"modifiers": [
