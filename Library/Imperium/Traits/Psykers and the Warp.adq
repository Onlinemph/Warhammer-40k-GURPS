									"name": "Warp",
									"cost_adj": "-15%"
								},
								{
									"id": "mudovOg9iCOHR-Pm1",
									"name": "Perils of the Warp",
									"cost_adj": "-10%"
								}
							],
							"base_points": 20
						},
						{
							"id": "tnpOVCfggNf7M-ALB",
							"name": "Dominate",
							"local_notes": "Lore: Seizes outright control of a target's body and actions.\n\nDesign: Mind Control, Basic's core advantage, flat 50, with Warp/Perils.",
							"tags": [
								"Advantage",
