					"id": "tHnbKbB2umQ3oulhg",
					"name": "Discriminatory Smell",
					"reference": "B49",
					"base_points": 15
				},
				{
					"id": "tINDvU-Y0IFD_BZtq",
					"name": "Acute Taste & Smell",
					"reference": "B35",
					"points_per_level": 2,
					"can_level": true,
					"levels": 3
				}
			]
		},
		{
			"id": "T2UMimpFeYg5SH9Iw",
			"name": "Mucranoid",
			"local_notes": "Lore: Secretes a waxy, oily film that can be triggered to seal pores and orifices against vacuum, toxic atmosphere, and radiation, and that also insulates against extreme heat and cold.\n\nDesign: Sealed (B82, 15 points) covers vacuum/toxin/radiation sealing; Temperature Tolerance 5 (B93, 1/level, 5 points) covers the thermal insulation. 20 points total.",
			"tags": [
				"Advantage",
				"Physical",
				"Imperium",
				"Adeptus Astartes"
			],
			"container_type": "meta_trait",
			"children": [
