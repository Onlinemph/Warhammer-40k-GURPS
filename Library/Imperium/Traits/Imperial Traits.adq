				{
					"id": "t5e_KE7irgD9Nhh1i",
					"name": "Uneasy Far From the Machine-God's Halls",
					"local_notes": "Lore: Forge-world natives find purely organic, unindustrialised places subtly wrong.\n\nDesign: Quirk (B9), roleplaying flag only.",
