					"name": "Forge-Born",
					"local_notes": "Lore: Grew up around machines and the rites that keep them running.\n\nDesign: Perk (B9), +1 to Mechanic (any).",
					"tags": [
						"Perk",
						"Imperium"
					],
					"base_points": 1,
