					"modifier": -4
				}
			],
			"points": 1
		},
		{
			"id": "sBJX4tk502oQDxzNC",
			"name": "Guns",
			"local_notes": "Lore: A laspistol for self-defense; an Enginseer is a technician first.\n\nDesign: DX+1 (13) for 2 points, Easy.",
			"tags": [
