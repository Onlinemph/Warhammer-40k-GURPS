			"points": 8
		},
		{
			"id": "s-WjX84BCAI0oY9dO",
			"name": "Hidden Lore",
			"local_notes": "Lore: Recognising STC fragments and Dark Age relics; see Imperium/Skills/Imperial Skills.skl.\n\nDesign: IQ+1 (14) for 4 points, Average.",
			"tags": [
				"Imperium",
				"Adeptus Mechanicus"
			],
			"specialization": "Archeotech",
			"difficulty": "iq/a",
			"points": 4
		},
		{
			"id": "s7827i6ex7WatCG7g",
			"name": "Language",
			"reference": "B23",
			"local_notes": "Lore: The Cult Mechanicus' machine-cant: a clipped, heavily compressed binary/logical language spoken and sub-vocalized between adepts, servitors, and machine spirits alike, ranging from a few ritual phrases a menial picks up to the dense technical liturgy a Magos trades with another Magos.\n\nDesign: IQ+1 (14) for 4 points, Average — comfortably fluent in the liturgical cant.",
			"tags": [
				"Mental",
				"Imperium",
				"Adeptus Mechanicus"
			],
			"specialization": "Binharic",
			"difficulty": "iq/a",
			"points": 4
		},
		{
			"id": "sba07-n93oMPP6IrN",
			"name": "Savoir-Faire",
			"reference": "B218",
			"local_notes": "Lore: Court protocol inside the Priesthood: correct forms of address for a Magos or Archmagos, ritual precedence between Forge Worlds and Explorator fleets, and which questions are simply never asked of a superior adept. Not attested under this exact name in the fiction, but the Mechanicus is consistently shown (across Black Library and codex background) to run on a court culture at least as rigid as the Ecclesiarchy's own.\n\nDesign: IQ+0 (13) for 1 point, Easy.",
			"tags": [
				"Mental",
				"Imperium",
				"Adeptus Mechanicus"
			],
			"specialization": "Adeptus Mechanicus",
			"difficulty": "iq/e",
			"defaults": [
				{
					"type": "iq",
					"modifier": -4
				}
			],
			"points": 1
		},
		{
			"id": "s0hHJwzJKzue-kci0",
			"name": "First Aid",
			"local_notes": "Lore: Battlefield first aid, more habit from working around wounded troopers than a specialty.\n\nDesign: IQ+0 (13) for 1 point, Easy.",
			"tags": [
				"Imperium"
			],
			"difficulty": "iq/e",
			"points": 1
		},
		{
			"id": "syT7suSxrtanyh8nU",
			"name": "Research",
			"local_notes": "Lore: Archive and STC-fragment cross-referencing.\n\nDesign: IQ+0 (13) for 2 points, Average.",
			"tags": [
				"Imperium"
			],
			"difficulty": "iq/a",
			"points": 2
		},
		{
			"id": "sU-A3LDUFKBOX5VFO",
			"name": "Current Affairs",
			"reference": "B186",
			"local_notes": "Lore: What passes for Imperium-wide news: Munitorum bulletins, Ecclesiarchy pronouncements, and whatever rumours of war and heresy filter down through a thousand relay stations, usually months stale and already propaganda by the time they arrive.\n\nDesign: IQ+0 (13) for 1 point, Easy.",
			"tags": [
