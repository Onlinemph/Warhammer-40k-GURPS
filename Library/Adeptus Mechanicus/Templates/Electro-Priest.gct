		{
			"id": "sIOVVqM00kXWkM69g",
			"name": "Theology",
			"local_notes": "Lore: Deep, willingly-embraced doctrine of the Motive Force -- an Electro-Priest's whole identity is built on this, unlike a Skitarii's much lighter catechism; see Imperium/Skills/Imperial Skills.skl.\n\nDesign: IQ+2 (12) for 12 points, Hard.",
			"tags": [
				"Imperium",
				"Adeptus Mechanicus"
			],
			"specialization": "Cult Mechanicus",
			"difficulty": "iq/h",
			"points": 12
		},
		{
			"id": "s5T6Zcpq5z-WnIX2N",
			"name": "Savoir-Faire",
			"reference": "B218",
			"local_notes": "Lore: Court protocol inside the Priesthood: correct forms of address for a Magos or Archmagos, ritual precedence between Forge Worlds and Explorator fleets, and which questions are simply never asked of a superior adept. Not attested under this exact name in the fiction, but the Mechanicus is consistently shown (across Black Library and codex background) to run on a court culture at least as rigid as the Ecclesiarchy's own.\n\nDesign: IQ+0 (10) for 1 point, Easy.",
			"tags": [
				"Mental",
				"Imperium",
				"Adeptus Mechanicus"
			],
			"specialization": "Adeptus Mechanicus",
			"difficulty": "iq/e",
			"defaults": [
				{
					"type": "iq",
					"modifier": -4
				}
			],
			"points": 1
		},
		{
			"id": "sEQsDKrRD5mGfGyxi",
			"name": "Intimidation",
			"local_notes": "Lore: A crackling, sparking, doctrinally certain zealot needs no words to be threatening.\n\nDesign: Will+0 (12) for 2 points, Average.",
			"tags": [
				"Imperium"
			],
			"difficulty": "will/a",
			"points": 2
		},
