			"difficulty": "dx/a",
			"points": 8
		},
		{
			"id": "sztBI_pFo_Ls5Ou-R",
			"name": "Brawling",
			"local_notes": "Lore: A fallback routine for when the mounted weapon runs dry.\n\nDesign: DX+0 (9) for 1 point, Easy.",
			"tags": [
