		},
		{
			"id": "s4ABmxa9p2VWvUrFJ",
			"name": "Physician",
			"local_notes": "Lore: Biological (as opposed to augmetic) medicine, kept current for supervising augmentation surgery.\n\nDesign: IQ+1 (16) for 8 points, Hard.",
			"tags": [
				"Imperium"
			],
			"difficulty": "iq/h",
			"points": 8
		},
		{
			"id": "s0VMzwaImuxiPRvUM",
			"name": "Surgery",
			"local_notes": "Lore: The surgical half of augmetic implantation.\n\nDesign: IQ+0 (15) for 8 points, Very Hard.",
			"tags": [
				"Imperium"
			],
			"difficulty": "iq/vh",
			"points": 8
		},
		{
			"id": "sokRRH6mheDbHO9Zc",
			"name": "Theology",
			"local_notes": "Lore: Deep command of Cult doctrine, expected of anyone senior enough to instruct novices; see Imperium/Skills/Imperial Skills.skl.\n\nDesign: IQ+2 (17) for 12 points, Hard.",
			"tags": [
				"Imperium",
				"Adeptus Mechanicus"
			],
			"specialization": "Cult Mechanicus",
			"difficulty": "iq/h",
			"points": 12
		},
		{
			"id": "sykU5nFotGhzcX29e",
			"name": "Hidden Lore",
			"local_notes": "Lore: STC and Dark Age relic cataloguing, a Magos' bread and butter; see Imperium/Skills/Imperial Skills.skl.\n\nDesign: IQ+2 (17) for 8 points, Average.",
			"tags": [
				"Imperium",
				"Adeptus Mechanicus"
			],
			"specialization": "Archeotech",
			"difficulty": "iq/a",
			"points": 8
		},
		{
			"id": "s-LL5QgshvBFdRfLN",
			"name": "Hidden Lore",
			"local_notes": "Lore: Xenotech familiarity, useful and doctrinally suspect in equal measure; see Imperium/Skills/Imperial Skills.skl.\n\nDesign: IQ+1 (16) for 4 points, Average.",
			"tags": [
				"Imperium"
			],
			"specialization": "Xenos",
			"difficulty": "iq/a",
			"points": 4
		},
		{
			"id": "s_GwKcXoazU_cuawR",
			"name": "Research",
			"local_notes": "Lore: Archive work across Administratum and Mechanicus record-stacks.\n\nDesign: IQ+1 (16) for 4 points, Average.",
			"tags": [
				"Imperium"
			],
			"difficulty": "iq/a",
			"points": 4
		},
		{
			"id": "sZ2-Rl5-viXWz-qpq",
			"name": "Administration",
			"local_notes": "Lore: Running a manufactorum wing's staff, output quotas, and requisitions.\n\nDesign: IQ+1 (16) for 4 points, Average.",
			"tags": [
				"Imperium"
