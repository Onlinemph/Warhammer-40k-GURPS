		{
			"id": "siGRM-qSNPQKdd8Ja",
			"name": "Electronics Operation",
			"local_notes": "Lore: Day-to-day cogitator operation, distinct from the repair skill above.\n\nDesign: IQ+1 (16) for 4 points, Average.",
			"tags": [
