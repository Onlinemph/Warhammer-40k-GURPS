				{
					"type": "attribute_bonus",
					"attribute": "basic_move",
					"amount": 1
				}
			]
		},
		{
			"id": "tLfWvFYubauiPjP6l",
			"name": "Auto-senses, Skitarii Pattern",
			"reference": "B60",
			"local_notes": "Infravision; Acute Vision +2 (a +2 to the Vision roll, applied by the sheet).\n\nLore: The standard-issue ocular augmetic fitted to almost every Skitarii and forge-world menial: crude compared to a Magos' oculars, but enough to fight in smoke, dust, and near-total darkness without a lumen pack.\n\nDesign: Infravision (B60, 10) + Acute Vision +2 (B35, 2/level, 4) = 14 points.",
			"tags": [
				"Advantage",
				"Physical",
				"Imperium",
				"Adeptus Mechanicus"
			],
			"base_points": 14,
			"features": [
