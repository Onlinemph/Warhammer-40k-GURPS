			]
		},
		{
			"id": "tKy5Uaq0E4Bv6o_Vh",
			"name": "Multi-lens Oculars, Magos Pattern",
			"reference": "B60",
			"local_notes": "Infravision; Dark Vision; Acute Vision +2 (applied by the sheet); Protected Sense (Vision).\n\nLore: A senior Tech-Priest's full ocular replacement: banks of interchangeable lenses that between them see by heat, by full dark, and by ordinary light with equal clarity, behind housings hardened against flash and glare — the source of the characteristic red or augmetic-lensed stare Black Library repeatedly gives high-ranking Magi.\n\nDesign: Infravision (B60, 10) + Dark Vision (B60, 25) + Acute Vision +2 (B35, 4) + Protected Sense (Vision) (B78, 5) = 44 points.",
			"tags": [
				"Advantage",
				"Physical",
				"Imperium",
				"Adeptus Mechanicus"
			],
			"base_points": 44,
			"features": [
				{
					"type": "attribute_bonus",
					"attribute": "vision",
					"amount": 2
				}
			]
		},
		{
			"id": "tSz-kqrcr50uTYGAW",
			"name": "Cranial Circuitry",
			"local_notes": "Lore: A basic subcutaneous data-port and skull-mounted junction box, common to nearly every ordained Tech-Priest: the hardware prerequisite for plugging into a standard Mechanicus cogitator terminal or picter-feed, rather than any enhancement to the mind behind it.\n\nDesign: 1-point Perk (B9): waives the unfamiliarity penalty for operating a Mechanicus-standard terminal, by direct analogy with how Black Carapace (Imperium/Traits/Astartes Gene-Seed.adq) is priced as the interface hardware rather than the capability it plugs into.",
			"tags": [
				"Advantage",
				"Mental",
				"Imperium",
				"Adeptus Mechanicus",
				"Perk"
			],
			"base_points": 1
		},
		{
			"id": "tP-EZnJWLHShQ0opm",
			"name": "Cortex Implant, Logis Pattern",
			"local_notes": "Eidetic Memory; Lightning Calculator.\n\nLore: A cogitator wafer grafted directly to the parietal cortex, banking perfect recall of anything the adept has read or witnessed and running arithmetic as fast as a slate abacus — the piece of kit behind a Tech-Priest's habit of reciting exact figures and quoting obscure STC clauses from memory.\n\nDesign: Eidetic Memory (B51, 5) + Lightning Calculator (B66, 2) = 7 points.",
			"tags": [
				"Advantage",
				"Mental",
				"Imperium",
				"Adeptus Mechanicus"
			],
			"base_points": 7
		},
		{
			"id": "tArlGuq5KgxCMEELc",
			"name": "Respirator Plugs (Filtration Lungs)",
			"reference": "B55",
			"local_notes": "Lore: Grille-covered intake valves set into the throat or chest, scrubbing forge smog, promethium fumes, and toxic industrial atmosphere before it reaches the lungs — near-universal among Mechanicus adepts who spend their working lives on a forge-world's surface.\n\nDesign: Basic Set Filter Lungs (B55), 5 points.",
			"tags": [
				"Advantage",
				"Physical",
				"Imperium",
				"Adeptus Mechanicus"
			],
			"base_points": 5
		},
		{
			"id": "t7S9zb_32qiB2Ck9J",
			"name": "Subdermal Armour Plating",
			"reference": "B46",
			"local_notes": "DR 1 per level, all locations (2 levels = DR 2); stacks with worn armor.\n\nLore: Ceramite or plasteel weave grafted beneath the skin across the whole body, rather than replacing a specific organ or limb — a whole-body counterpart to the Astartes' Ossmodula (which is DR 3 to torso and vitals only), bought by Tech-Priests who expect to take a hit.\n\nDesign: Plain Damage Resistance (B46), 5 points/level, no location restriction since it covers the whole body. Bought here at a default 2 levels (DR 2, 10 points); raise or lower the level to taste. The DR is a real per-level feature, so changing the level changes the sheet. Suggested levels: Magos 2-3, Skitarii 3, Servitor 4.",
			"tags": [
				"Advantage",
				"Physical",
				"Imperium",
				"Adeptus Mechanicus"
			],
			"points_per_level": 5,
			"can_level": true,
			"levels": 2,
			"features": [
				{
					"type": "dr_bonus",
					"locations": [
						"all"
					],
					"amount": 1,
					"per_level": true
				}
			]
		},
		{
			"id": "txNJTifpWn8cm6IMQ",
			"name": "Mind Impulse Unit",
			"local_notes": "Lore: A direct neural tap threaded into the spine and motor cortex, letting its bearer drive a war machine, servo-harness, or Dreadnought sarcophagus as an extension of their own body rather than through manual controls. Fitted to Techmarines, Dreadnought-interred Ancients, and Titan princeps alike.\n\nDesign: A 1-point Perk (B9): the prerequisite hardware for using MIU-linked equipment, priced the same way as Black Carapace (Imperium/Traits/ Astartes Gene-Seed.adq) — the actual mechanical payoff (no penalty for driving an MIU-linked machine, full reflexes through it) belongs on that equipment's own entry, since the implant does nothing for a bearer with nothing to plug it into.",
			"tags": [
				"Advantage",
				"Mental",
				"Imperium",
				"Adeptus Mechanicus",
				"Perk"
			],
			"base_points": 1
		},
		{
			"id": "t_vaGo13ncCIAfhzR",
			"name": "Noospheric Link",
			"reference": "B91",
			"local_notes": "Short-to-medium range wireless data-link to the Cult Mechanicus' noosphere: other Noospheric Link-bearing adepts and compatible cogitators/machine spirits only.\n\nLore: A subcutaneous vox-and-data transceiver that lets a Tech-Priest read and post to the layered, half-mystical data-cloud the Mechanicus calls the noosphere — status runes, binharic liturgy, and tactical chatter overlaid on the world for anyone plugged in, and gibberish static to anyone who isn't.\n\nDesign: Basic Set Telecommunication (Radio type, B91, 10 points) with the Racial limitation (B91, -20%, restricted to others who share the trait — here, other noosphere-linked adepts and machine spirits): 10 x 0.8 = 8 points. Pairs with the Language (Binharic) skill (Adeptus Mechanicus/Skills/Mechanicus Skills.skl) for the liturgical cant spoken over the link; the link itself is the hardware, the language is the learned code riding on it.",
			"tags": [
				"Advantage",
				"Mental",
				"Imperium",
				"Adeptus Mechanicus"
			],
			"base_points": 8
		},
		{
			"id": "txNnJvnA5sZlqDIXt",
			"name": "Rapport with Machine-Spirits",
			"reference": "B40",
			"local_notes": "As Animal Empathy, but for machines: a +2 reaction bonus from machine spirits (GM's call on what that means for an unintelligent device), and the ability to sense a machine's \"mood\" and calm or unsettle it as if it were an animal.\n\nLore: The Cult Mechanicus teaches that every machine, however humble, is inhabited by a spirit that must be placated, not merely serviced; some adepts are, by temperament or training, unusually good at reading and soothing that spirit — coaxing a failing plasma reactor to hold together a little longer, or a balky servitor to obey. This project does not model an outright \"talk to any machine\" power (that belongs to Ultra-Tech's Machine Empathy advantage, which this project does not use); this is Basic Set's own animal-handler's knack, reapplied to machines instead of beasts.\n\nDesign: Built as a direct structural copy of Basic Set Animal Empathy (B40, 5 points) with \"animals\" replaced by \"machine spirits\" throughout — same narrow scope, same cost, not a renamed Ultra-Tech/Bio-Tech advantage.",
			"tags": [
				"Advantage",
				"Mental",
				"Imperium",
				"Adeptus Mechanicus"
			],
			"base_points": 5
		},
		{
			"id": "tdOXuSGF5wBmyw5uV",
			"name": "Mechadendrite, Manipulator Pattern",
			"reference": "B53",
			"local_notes": "Extra Arm, Extra-Flexible.\n\nLore: A slender, many-jointed limb tipped with fine manipulator digits and micro-tools — the classic image of a Tech-Priest's back-mounted \"third and fourth hands,\" used for delicate work a human hand can't manage: micro-soldering, data-slate transcription, surgery.\n\nDesign: Extra Arm (B53, 10) with the Extra-Flexible modifier (B53, +50%): 10 x 1.5 = 15 points.",
			"tags": [
				"Advantage",
				"Physical",
				"Imperium",
				"Adeptus Mechanicus"
			],
			"base_points": 15
		},
		{
			"id": "tTlRUFmn4H9VtuejF",
			"name": "Mechadendrite, Utility Pattern",
			"reference": "B53",
			"local_notes": "Extra Arm (Weak, half body ST), Payload 1.\n\nLore: A general tool-limb: a socketed head that swaps between screwdriver, clamp, laslock loader, and a dozen other fittings a field Tech-Priest needs on hand, plus a small internal magazine for spare parts.\n\nDesign: Extra Arm (B53, 10) with the Weak modifier (half body ST, -25%; a slender tool-limb, not a lifting limb): 10 x 0.75 = 7.5, plus Payload 1 (B74, 1 point, for the internal parts magazine) = 8.5, rounded to 9.",
			"tags": [
				"Advantage",
				"Physical",
				"Imperium",
				"Adeptus Mechanicus"
			],
			"base_points": 9
		},
		{
			"id": "tu6ZnwIC4NH4TTOyp",
			"name": "Mechadendrite, Medicae Pattern",
			"reference": "B53",
			"local_notes": "Extra Arm (Weak, half body ST), Payload 1.\n\nLore: Fitted with surgical grippers, synth-flesh dispensers, and injector ampoules instead of general tools — the limb an Apothecary-trained Tech-Priest or a battlefield chirurgeon-adept uses to work on a patient with both hands still free for something else.\n\nDesign: Identical build to the Utility Pattern above (Extra Arm, Weak -25%, plus Payload 1 for the injector/synth-flesh reservoir instead of spare parts): 9 points. Kept as a separate entry per framework.md's instruction to list each mechadendrite pattern individually, since a character sheet should show which tools a given limb actually carries.",
			"tags": [
				"Advantage",
				"Physical",
				"Imperium",
				"Adeptus Mechanicus"
			],
			"base_points": 9
		},
		{
			"id": "tOWelK5la4iSdleFY",
			"name": "Mechadendrite, Ballistic Pattern",
			"reference": "B53",
			"local_notes": "Extra Arm, Weapon Mount: can aim and fire a mounted weapon (bought separately as equipment) but do nothing else — no fine manipulation, no unarmed use.\n\nLore: A rigid, gyro-stabilized mount rather than a true limb, built to carry a phosphor blaster, flamer, or similar sidearm slaved to its bearer's targeting cortex and fired independently of the hands.\n\nDesign: Extra Arm (B53, 10) with the Weapon Mount modifier (B53, -80%): 10 x 0.2 = 2 points. The weapon it carries is a separate equipment purchase, not part of this trait.",
			"tags": [
				"Advantage",
				"Physical",
				"Imperium",
				"Adeptus Mechanicus"
			],
			"base_points": 2
		},
		{
			"id": "tJLA-akbV29ZL2YvU",
			"name": "Servo-Arm",
			"reference": "B53",
			"local_notes": "Extra Arm; Lifting ST +8; Striking ST +3 (both applied by the sheet); Payload 1. This is the body-mounted implant; the Servo-arm and Electroleech Stave in the melee weapons file are separate carried tools, and a build using the implant should not also buy the gear version for the same limb.\n\nLore: The heavy, back-mounted tool-arm carried by Enginseers and Techmarines: strong enough to tear open a sealed hatch or wrench a fused component free, and — as more than one heretic has learned the hard way — strong enough to crush a skull if its bearer chooses.\n\nDesign: Extra Arm (B53, 10) + Lifting ST +8 (B65, 3/level, 24) for heavy lifting/grappling work + Striking ST +3 (B88, 5/level, 15) for its use as an improvised weapon + Payload 1 (B74, 1) for a small tool magazine = 50 points.",
			"tags": [
				"Advantage",
				"Physical",
				"Imperium",
				"Adeptus Mechanicus"
			],
			"base_points": 50,
			"features": [
				{
					"type": "attribute_bonus",
					"attribute": "lifting_st",
					"amount": 8
				},
				{
					"type": "attribute_bonus",
					"attribute": "striking_st",
					"amount": 3
				}
			]
		},
		{
			"id": "tPxo44b7VwLd3N6u4",
			"name": "Logis Cogitator",
			"reference": "B90",
			"local_notes": "+1/level to Mathematics, Navigation, Engineer, and Computer Programming/Operation.\n\nLore: A heavier processing implant than a simple Cortex Implant: a bank of logic-engines fused to the adept's own thought, running calculations, trajectory solutions, and STC cross-references far faster than an unaugmented mind — the hardware behind a Magos' habit of answering a complex calculation before the question is finished.\n\nDesign: Built as a custom Talent per B89-91's costing table: a \"small\" group of four related skills (Mathematics, Navigation, Engineer, Computer Programming/Operation) costs 5 points/level. Not a renamed Ultra-Tech implant — a Basic Set Talent construction, same as any other in-setting Talent.",
			"tags": [
				"Advantage",
				"Mental",
				"Imperium",
				"Adeptus Mechanicus"
			],
			"points_per_level": 5,
			"can_level": true,
			"levels": 1
		},
		{
			"id": "t_EmYmKxmbf9CawhA",
			"name": "Potentia Coil",
			"reference": "B80",
			"local_notes": "Reduced Consumption, applied to powering augmetic systems rather than food.\n\nLore: A subcutaneous capacitor bank that trickle-charges off the bearer's own biotic processes and background energy, letting heavily-augmented adepts go far longer between visits to a recharge shrine than their augmetics would otherwise need.\n\nDesign: Reduced Consumption (B80, 2 points/level) reflavored from food/fuel intake to augmetic power draw — same mechanical shape (needing an external resource only a fraction as often), different resource.",
			"tags": [
				"Advantage",
				"Physical",
				"Imperium",
				"Adeptus Mechanicus"
			],
			"points_per_level": 2,
			"can_level": true,
			"levels": 1
		},
		{
			"id": "tkDXoUwhjFNvVNpCH",
			"name": "Electoo Inductors",
			"local_notes": "Lore: Circuit-tattoos inlaid with conductive metal, threaded through the whole nervous system of every Electro-Priest: the hardware base that the Voltagheist Field, Electrostatic Gauntlets, and Electroleech Staff are all built on top of.\n\nDesign: A 1-point Perk (B9) marking the tattoo hardware's presence, by the same convention as Cranial Circuitry and the Mind Impulse Unit above — the actual mechanical payoff lives on the traits built from it, not here.",
			"tags": [
				"Advantage",
				"Physical",
				"Imperium",
				"Adeptus Mechanicus",
				"Electro-Priest",
				"Perk"
			],
			"base_points": 1
		},
		{
			"id": "TkNc2SFGw_pHD8tRU",
			"name": "Voltagheist Field",
			"local_notes": "Lore: The crackling, visible aura of Motive Force every Electro-Priest radiates: a permanent bio-electric field that shrugs off attacks outright before the priest's own body-integrated insulation has to deal with whatever gets through, and shields the priest from their own discharges besides.\n\nDesign: Built as a character trait using this project's own regenerating- shield mechanic (framework.md, \"Personal force fields\"), sized \"a bit less than a Rosarius\" per the Cult's lower-tier manufacture: 50 SP against the Rosarius' 60 (Imperium/Armour/Force Fields.eqp), same 3-second recharge delay, at the Refractor Field's faster 10 SP/second regen (this is a body-integrated field maintained by a living, actively-charging bio-battery, not a passive relic). Basic Set has no advantage that directly prices a finite, recharging damage pool — this mechanic is already a documented project-wide departure from RAW (docs/changelog.md, \"Personal force fields are regenerating shields\") — so this project prices it as a trait at its own transparent, disclosed rate of 0.5 character points per Shield Point: 50 x 0.5 = 25. Voltaic Insulation is ordinary Damage Resistance (B46, 5/level) at level 8 (40 points), restricted to burning/electrical damage only via the `vs` mechanism (an estimated -40% limitation, by the same \"restrict a broad DR buy to a narrower case\" logic this project already uses for Partial DR elsewhere in this file): 40 x 0.6 = 24. Container total 25 + 24 = 49 points. This directly answers \"immunity or strong resistance to electrical damage and their own discharges\": Voltaic Insulation cuts any electrical/burning hit that gets past the Field's Shield Points by 8 before it touches HP, and the Field itself absorbs their own overcharge backlash the same as an enemy's attack.",
			"tags": [
				"Advantage",
				"Physical",
				"Imperium",
				"Adeptus Mechanicus",
				"Electro-Priest"
			],
			"container_type": "meta_trait",
			"children": [
				{
					"id": "tuf2L59xvZzfT7lpF",
					"name": "Field Shield Points",
					"local_notes": "Shield 50 SP. Recharge: after 3 seconds without taking damage, regains 10 SP per second. Blocks ranged and melee attacks, including overflow from the priest's own Electrostatic Gauntlets/Electroleech Staff. Track current SP with a GCS Uses counter, exactly as the equipment-side fields in Imperium/ Armour/Force Fields.eqp do.",
					"base_points": 25
				},
				{
					"id": "tUNt8nqI3_sZhFOQ3",
					"name": "Voltaic Insulation",
					"reference": "B46",
					"local_notes": "DR 8, all locations, vs. burning (electrical) damage only.",
					"base_points": 24,
					"features": [
						{
							"type": "dr_bonus",
							"locations": [
								"all"
							],
							"amount": 8,
							"specialization": "burn"
						}
					]
				}
			]
		},
		{
			"id": "tX0Kzk2AJ2dQObkmb",
			"name": "Electrostatic Gauntlets, Corpuscarii Pattern",
			"reference": "B61",
			"local_notes": "Innate Attack (Burning, reflavored electrical), armor divisor (2), ranged. At the default 7 levels: 7d(2) burn, lasgun strength.\n\nLore: Corpuscarii Electro-Priests wear gauntlets that focus their internal charge into a thrown arc of lightning rather than a touch-range jolt — a ranged weapon in its own right, not just a defensive field.\n\nDesign: Innate Attack (Burning) (B61, 5 points/die) with Armor Divisor (2) (B102, +50%): 5 x 1.5 = 7.5, rounded up to 8 points/die. Default 7 levels (56 points) gives 7d(2) burn, the lasgun anchor: the fiction shows Corpuscarii lightning killing armoured men, which a pistol-strength arc (an earlier 3d(2) draft) couldn't do. Exact odds per hit: flak (DR 30, eff. 15) 98%; carapace (eff. 35) 0.6%; Astartes plate never. Still an anti-infantry weapon, not anti-armour.",
			"tags": [
				"Advantage",
				"Physical",
				"Imperium",
				"Adeptus Mechanicus",
				"Electro-Priest"
			],
			"points_per_level": 8,
			"can_level": true,
			"levels": 7,
			"weapons": [
				{
					"id": "WvsR0KWrsbeuBht7E",
					"sv": 1,
					"damage": {
						"type": "burn",
						"base": "7d",
						"armor_divisor": 2
					},
					"accuracy": "3",
					"range": "10/100",
					"rate_of_fire": "1",
					"shots": "-",
					"usage": "Lightning arc",
					"usage_notes": "Innate Attack range and Acc for a burning beam (B61). Added so GCS and the combat simulator can roll the arc as a weapon.",
					"defaults": [
						{
							"type": "skill",
							"name": {
								"compare": "is",
								"qualifier": "Innate Attack"
							},
							"specialization": {
								"compare": "is",
								"qualifier": "Beam"
							}
						},
						{
							"type": "dx",
							"modifier": -4
						}
					]
				}
			]
		},
		{
			"id": "tPhcwxIxovrADUG3m",
			"name": "Electroleech Staff, Fulgurite Pattern",
			"reference": "B61",
			"local_notes": "Innate Attack (Fatigue), melee reach 1, Leech (the priest recovers FP equal to the damage inflicted, up to their own maximum). At the default 4 levels: 4d fatigue damage, ignoring DR entirely.\n\nLore: Fulgurite Electro-Priests carry a long voltaic stave that doesn't so much burn a target as drain the electrochemical charge straight out of their nervous system, feeding it back into the wielder — a stagger and a jolt of stolen vitality in the same swing.\n\nDesign: Innate Attack (Fatigue) (B61, 10 points/die; fatigue damage is priced at double a normal physical Innate Attack precisely because it bypasses DR outright, going straight to FP) with the Melee Attack, Reach 1 limitation (B112, -25%, the exact value the Basic Set data gives for a one-hex-reach melee-only restriction) and a Leech enhancement (this project's own construction, since Basic Set itself has no leech/drain-to-heal mechanic; costed at the same +50% published for the equivalent enhancement in GURPS Powers, cited here only for the percentage, not as a Basic Set source) that returns the wielder's own FP equal to the damage inflicted: 10 x (1 - 0.25 + 0.50) = 10 x 1.25 = 12.5, rounded up to 13 points/die. At the default 4 levels (52 points; raised from 2 so a Fulgurite can drop a man in two or three blows, as the fiction shows), this drains 4d FP (ignoring DR, so carapace or even Astartes plate is irrelevant to it) and restores the same amount to the wielder's own FP pool -- a real threat to anything that still has FP to lose, and no threat at all to a construct or Injury Tolerance (Unliving) target with no FP to drain, which is exactly the \"drains energy\" niche this pattern is known for in the fiction rather than a flat damage upgrade over the Corpuscarii pattern.",
			"tags": [
				"Advantage",
				"Physical",
				"Imperium",
				"Adeptus Mechanicus",
				"Electro-Priest"
			],
			"points_per_level": 13,
			"can_level": true,
			"levels": 4
		},
		{
			"id": "Tnvk_YW2dI_cgdUmu",
			"name": "Servitor Lobotomy (Neural Excision)",
			"local_notes": "Lore: The surgical and chemical process that turns a criminal, debtor, or unfit citizen into a Servitor: swathes of the frontal cortex and speech centers are excised or chemically silenced, leaving a body that follows binharic command-cant and simple standing orders with total, uncomplaining obedience and nothing recognizable as a person behind the eyes.\n\nDesign: Slave Mentality (B154, -40, cannot disobey or act against orders) + Low Empathy (B142, -20, cannot read or care about others' feelings) + Cannot Speak (B145, -25, mute but for binharic response codes) = -85 points. Reduced IQ itself is bought on the character sheet (an attribute purchase, not an implant trait) — see Adeptus Mechanicus/Templates/Combat Servitor.gct for a worked example.",
			"tags": [
				"Disadvantage",
				"Mental",
				"Imperium",
				"Adeptus Mechanicus",
				"Servitor"
			],
			"container_type": "meta_trait",
			"children": [
				{
					"id": "t99nS5TF1-z4_kO2j",
					"name": "Slave Mentality",
					"reference": "B154",
					"base_points": -40
				},
				{
					"id": "tYE6CNN6b2a0YHR0k",
					"name": "Low Empathy",
					"reference": "B142",
					"base_points": -20
				},
				{
					"id": "tK32Zj44yW6lk6JtI",
					"name": "Cannot Speak (Mute)",
					"reference": "B145",
					"local_notes": "Some Servitor patterns retain a handful of vox-triggered stock responses at the GM's discretion; treat this as flavor, not a mechanical exception.",
					"base_points": -25
				}
			]
		},
		{
			"id": "t-NnDYsc5vYRuX5dj",
			"name": "Fanaticism (The Omnissiah)",
			"reference": "B136",
			"local_notes": "Lore: Doctrinal certainty that the Machine God — the same Emperor, in the Cult Mechanicus' own theology, understood as a being of pure technological perfection — must be served without question, and that His will (as interpreted by the Priesthood's hierarchy) justifies whatever it demands. Distinct from the Imperial Creed's Fanaticism (The God-Emperor) in Imperium/Traits/Imperial Traits.adq: the same shape of belief, aimed at a different reading of the same divinity.\n\nDesign: Basic Set Fanaticism (B136), flat -15, as the existing Imperial Fanaticism entry is built.",
			"tags": [
				"Disadvantage",
				"Mental",
				"Imperium",
				"Adeptus Mechanicus"
			],
			"base_points": -15
		},
		{
			"id": "tg-Sw3kufGTgJob_P",
			"name": "Disciplines of the Cult Mechanicus",
			"reference": "B127",
			"local_notes": "As Code of Honor: obey the ritual forms and chain of command of the Priesthood, never share proscribed knowledge outside sanctioned channels, never act against a superior adept's direct instruction without Martian sanction.\n\nLore: The Cult Mechanicus runs on ritual precision and a rigid hierarchy of knowledge: an adept who improvises outside sanctioned procedure, or who shares forbidden data with the unworthy, has broken discipline in a way their peers will report on sight.\n\nDesign: Basic Set Code of Honor (B127), moderate severity, -10 — the same cost this project already uses for Code of Honor (Codex Astartes) in Imperium/Traits/Astartes Gene-Seed.adq.",
			"tags": [
				"Disadvantage",
				"Mental",
				"Imperium",
				"Adeptus Mechanicus"
			],
			"base_points": -10
		},
		{
			"id": "tdmnObjmc49eP275Y",
			"name": "Distrust of Flesh",
			"reference": "B140",
			"local_notes": "Lore: Cult doctrine holds that unaugmented flesh is weak, corruptible, and an obstacle to the Machine God's perfection; many adepts, especially the more heavily augmented, come to regard baseline humans (even loyal Imperial citizens) with the same doctrinal contempt other Imperial institutions reserve for mutants or heretics.\n\nDesign: Basic Set Intolerance (B140), broad-category cost, -10 — built the same way this project's existing Intolerance (Xenos)/(Mutants) entries are (Imperium/Traits/Imperial Traits.adq).",
			"tags": [
				"Disadvantage",
				"Mental",
				"Imperium",
				"Adeptus Mechanicus"
			],
			"base_points": -10
		},
		{
			"id": "tM_rdkARJd3Xxrhj7",
			"name": "Dependency (Maintenance Rites and Sacred Unguents)",
			"reference": "B131",
			"local_notes": "Common substance (sanctified oils, incense, replacement components), needed roughly daily; 1d damage if a maintenance cycle is missed entirely.\n\nLore: A body carrying real augmetic load needs its joints oiled, its cabling checked, and its power cells topped up on a strict ritual schedule, or it seizes, shorts, or bleeds power — a problem the Cult Mechanicus dresses in liturgy, but a real, physical maintenance dependency underneath.\n\nDesign: An own-estimate application of Basic Set Dependency's guidelines (B131): a substance that's common and easy to obtain anywhere the Mechanicus has a presence, needed about daily, doing moderate (1d) damage if missed entirely. -10 points; a specific character with much rarer parts (an isolated relic-tech Servitor, say) should cost this disadvantage higher per the same table.",
			"tags": [
				"Disadvantage",
				"Physical",
				"Imperium",
				"Adeptus Mechanicus"
			],
			"base_points": -10
		},
		{
			"id": "tWR3JRNeb-daACWWe",
			"name": "Duty (Adeptus Mechanicus)",
			"reference": "B133",
			"local_notes": "Lore: A sworn Tech-Priest, Enginseer, or Skitarii answers first to their Forge World and its Fabricator-General, not to any Guard officer or Administratum functionary they happen to be attached to — a binding, frequent, but not universally life-threatening obligation (unlike a Guardsman's), since a Mechanicus posting is at least as often archival or industrial as it is a battlefield one.\n\nDesign: Basic Set Duty (B133), fairly frequent but not \"almost always hazardous\" the way Duty (Astra Militarum) is (Imperium/Traits/ Imperial Traits.adq) — pegged one tier below that entry, at -10, to reflect the Priesthood's broader range of postings. A Skitarii or a field-attached Enginseer/Techmarine should reasonably use -15 instead; -10 is this template's baseline for a workshop- or forge-based adept.",
			"tags": [
				"Disadvantage",
				"Social",
				"Imperium",
				"Adeptus Mechanicus"
			],
			"base_points": -10
		},
		{
			"id": "t-vK4kTeYR77zkXTG",
			"name": "Social Stigma (Heavily Augmented)",
			"reference": "B155",
			"local_notes": "Lore: Past a certain point of visible augmetic replacement, ordinary Imperial citizens stop reading a Tech-Priest as a person wearing machinery and start reading them as a machine wearing a person's shape — unease and minor deference-avoidance rather than outright hostility, but real, and consistent with how Black Library repeatedly writes civilian reactions to a fully-vested Magos.\n\nDesign: Basic Set Social Stigma (B155), minor-category cost, -5. A GM running a near-fully-mechanical Archmagos with almost no flesh left may reasonably price this at the \"Monster\" tier (-15) instead; this entry covers the ordinary working Tech-Priest or Skitarii.",
			"tags": [
				"Disadvantage",
				"Social",
				"Imperium",
				"Adeptus Mechanicus"
			],
			"base_points": -5
		},
		{
			"id": "torgyVqL0BgCdaXS6",
			"name": "Mechanicus Rank",
			"reference": "B29",
			"local_notes": "Levels: 1 Skitarii Alpha/menial overseer, 2-3 Enginseer, 4-5 Magos, 6-7 Archmagos, 8 Fabricator-Locum, 9 Fabricator-General of a Forge World.\n\nLore: The Priesthood's own hierarchy, parallel to (and largely independent of) any Imperial Guard or Administratum rank a Tech-Priest might also hold — a Magos answers to Mars and their Forge World's hierarchy first, an Imperial governor's authority a distant second.\n\nDesign: Basic Set Rank (B29), 5 points/level, by direct analogy with this project's existing Military Rank and Religious Rank entries (Imperium/Traits/Imperial Traits.adq).",
			"tags": [
				"Advantage",
				"Social",
				"Imperium",
				"Adeptus Mechanicus"
			],
			"points_per_level": 5,
			"can_level": true,
			"levels": 1,
			"max_levels": 9
		},
		{
			"id": "Tqx2Fb64sCGfaJuHv",
			"name": "Skitarii Doctrina Imperatives",
			"local_notes": "Lore: A Skitarii Maniple's cranial implants take a battle-doctrina uploaded before an engagement, biasing every Skitarii in the maniple toward one combat posture at a time: Protector (hold ground and shoot) or Conqueror (advance and shoot). The Codex names these two; the earlier draft's third, Hunter, is not in the sources this project could identify and has been dropped. A Skitarii can only run one imperative at a time and must be re-flashed (a Ready maneuver, or a scene break, at the GM's call) to switch.\n\nDesign: Basic Set Alternative Abilities (B61): buy the most expensive ability at full price and the rest at 1/5 cost (round up), since only one can be active. Full prices: Protector and Conqueror are each a narrow +1 combat Talent (B90-style, 5). GCS applies the Alternative Abilities discount natively for this container type; worked by hand, the effective total is 5 + ceil(5/5) = 6 points.",
			"tags": [
				"Advantage",
				"Mental",
				"Imperium",
				"Adeptus Mechanicus",
				"Skitarii"
			],
			"container_type": "alternative_abilities",
			"children": [
				{
					"id": "tF309Vvog3x4CMciP",
					"name": "Protector Imperative",
					"reference": "B90",
					"local_notes": "+1 to Guns and Gunner skills when the Skitarii did not move this turn (Talent-style construction, holding position).",
					"base_points": 5
				},
				{
					"id": "tMk0JflvSFqrp1edM",
					"name": "Conqueror Imperative",
					"reference": "B90",
					"local_notes": "+1 to Guns and Gunner skills when the Skitarii moved this turn (Talent-style construction, advancing fire).",
					"base_points": 5
				}
			]
		},
		{
			"id": "TyWbgiX0NXUB8kxx3",
			"name": "Rad-Saturation Field",
			"local_notes": "Lore: Skitarii Vanguard carry radium weapons whose ammunition and support systems bleed a low but constant field of ionizing radiation, harmless to the fully-sealed Skitarii themselves in the short term but a real hazard to anyone standing near one unprotected — and, over a long enough campaign, a hazard to the Vanguard too, one more reason Skitarii service so rarely ends in old age.\n\nDesign: Innate Attack (Toxic) (B61, 4/die) with Aura (B102, an estimated +80%, so it affects everyone in reach without an attack roll), Always On (B110, an estimated -20%, it can't be switched off) and Emanation (B112, an estimated -20%, it can't be aimed or withheld from allies): net +40%, 4 x 1.4 = 5.6, rounded to 6. Paired with Unfit (B160, -5) for the field's slow toll on its own bearer. Net 1 point: deliberately close to zero, since this is simultaneously a minor hazard-weapon and a curse, not a purchase anyone takes for the points.",
			"tags": [
				"Advantage",
				"Disadvantage",
				"Physical",
				"Imperium",
				"Adeptus Mechanicus",
				"Skitarii"
			],
			"container_type": "meta_trait",
			"children": [
				{
					"id": "tWVYezsUSn2qTgrPf",
					"name": "Ambient Radium Field",
					"reference": "B61",
					"local_notes": "Innate Attack (Toxic), 1 die, always on, affecting everyone adjacent (including allies) each turn they're in reach; HT to resist as normal for toxic damage.",
					"base_points": 6
				},
				{
					"id": "tYRtfQtiC1yN8ck33",
					"name": "Unfit",
					"reference": "B160",
					"local_notes": "The same field that saturates the air nearby also cooks its bearer slowly.",
					"base_points": -5
				}
			]
		},
		{
			"id": "TSQ3H_tacgiK6vFmI",
			"name": "Skitarii Conditioning",
			"local_notes": "Lore: Skitarii undergo extensive neural conditioning and cybernetic replacement of their own that, while far short of a Servitor's total lobotomy, strips away most of the emotional affect and small-talk that would otherwise mark them as still fully human — codex and Black Library background alike describe them as unnervingly flat and literal even next to other Mechanicus adepts.\n\nDesign: Low Empathy (B142, -20) + No Sense of Humor (B146, -10) + a 1-point Quirk (B9) for clipped, ritualized speech patterns = -31 points. Deliberately short of Servitor Lobotomy (Neural Excision) above: Skitarii still hold rank, opinions, and (per some Codex background) occasional flickers of the person they were, where a Servitor has none of that left.",
			"tags": [
				"Disadvantage",
				"Mental",
				"Imperium",
				"Adeptus Mechanicus",
				"Skitarii"
			],
			"container_type": "meta_trait",
			"children": [
				{
					"id": "tUPFxkJBZoJxSICsl",
					"name": "Low Empathy",
					"reference": "B142",
					"base_points": -20
				},
				{
					"id": "tCbUQvzG23wjUUY1M",
					"name": "No Sense of Humor",
					"reference": "B146",
					"base_points": -10
				},
				{
					"id": "ttpwo_iT-OewARhV2",
					"name": "Speaks Only in Clipped Binharic-Inflected Report",
					"tags": [
						"Quirk"
					],
					"base_points": -1
				}
			]
		}
	]
}
